#!/bin/sh
# NexusSec OS - selettore grafico del profilo operativo (GTK3).
# Avvio CALDO via demone (fork da GTK gia' importato); fallback all'avvio normale.
if command -v nxs-launch >/dev/null 2>&1 && nxs-launch profile "$@" 2>/dev/null; then
  exit 0
fi
for c in python3 python3.9 python3.11 python3.7; do
  if command -v "$c" >/dev/null 2>&1; then
    exec env GTK_IM_MODULE=gtk-im-context-simple PYTHONPATH=/usr/local/lib \
         "$c" -m nxs_profiles "$@"
  fi
done
echo "nxs-profile: python3 non disponibile" >&2
exit 1
