#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di NexusSec OS.
# nxs-fetch - riepilogo di sistema con il logo NexusSec (stile neofetch), in
# shell PURA (busybox ash): nessun pacchetto extra, poche centinaia di byte.
# Il logo (esagono + N a nodi, come il badge NexusSec) e' a DUE TONI: esagono
# nel colore del profilo attivo, N chiara (truecolor ANSI, 2026-11-22). Commutabile: nxs-fetch on|off.
#
#   nxs-fetch              stampa il riepilogo
#   nxs-fetch on|off       mostra/nasconde il fetch all'apertura del terminale
#   nxs-fetch toggle       inverte lo stato
#   nxs-fetch status       stampa on/off
#   nxs-fetch --if-enabled stampa SOLO se abilitato (lo usa ~/.config/nxs/shrc)
#
# Stato in ~/.config/nxs/fetch (assente = ON: si vede di default).
CONF="${HOME:-/root}/.config/nxs/fetch"

_enabled() { [ ! -f "$CONF" ] || [ "$(cat "$CONF" 2>/dev/null)" != "off" ]; }

case "${1:-show}" in
  on)     mkdir -p "$(dirname "$CONF")"; echo on  > "$CONF"; echo "fetch: attivo (apri un nuovo terminale)"; exit 0 ;;
  off)    mkdir -p "$(dirname "$CONF")"; echo off > "$CONF"; echo "fetch: disattivato"; exit 0 ;;
  toggle) if _enabled; then "$0" off; else "$0" on; fi; exit 0 ;;
  status) _enabled && echo on || echo off; exit 0 ;;
  --if-enabled) _enabled || exit 0 ;;
  show|"") ;;
  -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# --- accent del profilo (primo #rrggbb in accent.css) -> truecolor -----------
HEX=$(grep -oE '#[0-9a-fA-F]{6}' "${HOME}/.config/nxs/accent.css" 2>/dev/null | head -1)
HEX=${HEX:-#00e5ff}; HEX=${HEX#\#}
R=$(printf '%d' "0x${HEX%????}")
G=$(printf '%d' "0x$(printf '%s' "$HEX" | cut -c3-4)")
B=$(printf '%d' "0x$(printf '%s' "$HEX" | cut -c5-6)")
if [ -t 1 ]; then
  A="$(printf '\033')[38;2;${R};${G};${B}m"   # accent
  W="$(printf '\033')[38;2;200;245;255m"       # testo chiaro
  D="$(printf '\033')[38;2;90;138;154m"        # tenue
  Z="$(printf '\033')[0m"; BD="$(printf '\033')[1m"
else
  A=""; W=""; D=""; Z=""; BD=""
fi

# --- dati di sistema (tutto busybox-friendly) --------------------------------
ver="$(cat /etc/nexussec-release 2>/dev/null)"
base="Alpine"
[ -r /etc/os-release ] && . /etc/os-release 2>/dev/null && base="${PRETTY_NAME:-Alpine}"
base="$(printf '%s' "$base" | sed 's/ Linux//')"
os="${ver:-NexusSec OS} ${D}· ${base}"
kern="$(uname -r 2>/dev/null)"
host="$(hostname 2>/dev/null || cat /proc/sys/kernel/hostname 2>/dev/null)"
user="${USER:-$(id -un 2>/dev/null)}"
up=$(cut -d. -f1 /proc/uptime 2>/dev/null)
if [ -n "$up" ]; then uptime="$((up/3600))h $(((up%3600)/60))m"; else uptime="?"; fi
# pacchetti: contati dal database (apk info su chiavetta e' lento)
if [ -r /lib/apk/db/installed ]; then
  pkgs="$(grep -c '^P:' /lib/apk/db/installed 2>/dev/null) (apk)"
else
  pkgs="?"
fi
prof=""
[ -r "${HOME}/.config/nxs/profile" ] && prof="$(cat "${HOME}/.config/nxs/profile" 2>/dev/null)"
if [ -z "$prof" ] && [ -r /etc/sec_os/state.json ]; then
  prof=$(grep -oE '"(profile|key)"[ ]*:[ ]*"[^"]*"' /etc/sec_os/state.json 2>/dev/null | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
fi
prof="${prof:-base}"
# rete e dati: le due cose che contano sul campo
if [ -e /run/nxs-anon.on ]; then rete="anonima (Tor, kill-switch)"; else rete="normale"; fi
if grep -qw nxs_installed=1 /proc/cmdline 2>/dev/null; then
  dati="installato su disco, sistema in sola lettura"
elif mountpoint -q /var/nxs-data 2>/dev/null; then
  case "$(findmnt -no SOURCE /var/nxs-data 2>/dev/null)" in
    /dev/mapper/*) dati="persistenza attiva (cifrata)" ;;
    *) dati="persistenza attiva" ;;
  esac
else
  dati="live in RAM (nxs-persist per salvare)"
fi
tema="$(cat "${HOME}/.config/nxs/theme" 2>/dev/null)"
cpu="$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | sed 's/.*: //;s/  */ /g;s/([^)]*)//g;s/ CPU//;s/ @.*//')"
[ -z "$cpu" ] && cpu="$(grep -m1 'Model' /proc/cpuinfo 2>/dev/null | sed 's/.*: //')"
cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
[ -n "$cores" ] && [ -n "$cpu" ] && cpu="$cpu (${cores})"
memt=$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
mema=$(awk '/MemAvailable/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
if [ -n "$memt" ] && [ -n "$mema" ]; then mem="$((memt-mema)) / ${memt} MiB"; else mem="?"; fi

# --- righe informative --------------------------------------------------------
nl='
'
INFO=""
add() { INFO="${INFO}${A}${BD}${1}${Z}${W} ${2}${Z}${nl}"; }
riga() { INFO="${INFO}${1}${nl}"; }
riga ""
riga "${A}${BD}${user:-nexus}${Z}${D}@${Z}${A}${BD}${host:-nexussec}${Z}"
riga "${D}────────────────────────────${Z}"
add "sistema  " "$os"
add "kernel   " "$kern"
add "uptime   " "$uptime"
add "profilo  " "$prof"
add "rete     " "$rete"
add "dati     " "$dati"
add "pacchetti" "$pkgs"
add "finestre " "Openbox${tema:+ · $tema}"
[ -n "$cpu" ] && add "cpu      " "$cpu"
add "ram      " "$mem"
riga ""
# i colori dei cinque profili (base, pentest, forensics, osint, web)
BL=""
for c in $(grep -oE '"accent"[ ]*:[ ]*"#[0-9a-fA-F]{6}"' "${NXS_SHARE:-/usr/local/share/nexussec}/profiles.json" 2>/dev/null | grep -oE '[0-9a-fA-F]{6}'); do
  if [ -n "$Z" ]; then
    BL="${BL}$(printf '\033[38;2;%d;%d;%dm███\033[0m ' "0x$(echo $c | cut -c1-2)" "0x$(echo $c | cut -c3-4)" "0x$(echo $c | cut -c5-6)")"
  fi
done
[ -n "$BL" ] && riga "$BL"
INFO="${INFO%$nl}"

# --- logo a due toni (build/make-logo-fetch.py) -------------------------------
# Ogni cifra esadecimale = due pixel (sopra*4+sotto): 0 vuoto, 1 accent del
# profilo, 2 chiaro (la N), 3 accent tenue. Si stampano a mezzi blocchi con
# colori truecolor; senza terminale (pipe) o senza file: vecchio logo/minimo.
LOGOFILE="${NXS_SHARE:-/usr/local/share/nexussec}/logo-fetch.txt"
if [ -n "$Z" ] && [ -r "$LOGOFILE" ]; then
  LOGO="$(awk -v a="$R;$G;$B" -v m="$((R*45/100));$((G*45/100));$((B*45/100))" '
    BEGIN { c[1]=a; c[2]="200;245;255"; c[3]=m; E=sprintf("%c",27) }
    { o=""; for (i=1;i<=length($0);i++) {
        v=index("0123456789abcdef", substr($0,i,1))-1; t=int(v/4); b=v%4
        if (t==0 && b==0) o=o " "
        else if (b==0) o=o E "[38;2;" c[t] "m▀" E "[0m"
        else if (t==0) o=o E "[38;2;" c[b] "m▄" E "[0m"
        else if (t==b) o=o E "[38;2;" c[t] "m█" E "[0m"
        else o=o E "[38;2;" c[t] ";48;2;" c[b] "m▀" E "[0m"
      } print o }' "$LOGOFILE")"
  PAD="                              "
else
  LOGO="$(cat "${NXS_SHARE:-/usr/local/share/nexussec}/logo-emblem.txt" 2>/dev/null)"
  [ -n "$LOGO" ] || LOGO="   [ NexusSec ]   "
  PAD="                        "
fi

# --- stampa affiancata: logo a sinistra + info a destra -----------------------
echo
exec 3<<LOGOEOF
$LOGO
LOGOEOF
while IFS= read -r info; do
  if IFS= read -r logo <&3; then :; else logo="$PAD"; fi
  printf '%s%s%s   %s\n' "$A" "$logo" "$Z" "$info"
done <<INFOEOF
$INFO
INFOEOF
while IFS= read -r logo <&3; do
  printf '%s%s%s\n' "$A" "$logo" "$Z"
done
exec 3<&-
echo
