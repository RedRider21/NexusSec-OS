# nxs-installer - installatore GRAFICO di NexusSec su disco (sopra
# nxs-install-disco). Log: /tmp/nxs-installer.log (GUI) e
# /tmp/nxs-install-disco.log (installazione).
exec env GTK_IM_MODULE=gtk-im-context-simple PYTHONPATH=/usr/local/lib \
	python3 -m nxs_installer "$@" >>/tmp/nxs-installer.log 2>&1
