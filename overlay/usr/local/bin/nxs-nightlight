#!/bin/sh
# nxs-nightlight - filtro luce blu (night-light) con overlay traslucido.
#
# Metodo: uno strato ambra semitrasparente a schermo intero (composito da picom),
# che LASCIA PASSARE i click. A differenza di `xrandr --gamma`, funziona anche su
# GPU VIRTUALI (VM), dove la gamma spesso viene ignorata dal driver.
#
# Uso: nxs-nightlight on|off|toggle|status|restore
#   on      attiva il filtro (avvia l'overlay)
#   off     disattiva (chiude l'overlay)
#   toggle  inverte
#   status  on|off
#   restore riapplica lo stato salvato (usato in autostart)
set -eu

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/nxs"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/nxs"
STATE="$CFG/nightlight"
PIDF="$CACHE/nightlight.pid"
OVERLAY=/usr/local/lib/nxs-nightlight-overlay
STRENGTH=0.20

_running() {
  [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null
}

_start() {
  _running && return 0
  mkdir -p "$CACHE"
  python3 "$OVERLAY" "$STRENGTH" >/dev/null 2>&1 &
  echo $! > "$PIDF"
}

_stop() {
  [ -f "$PIDF" ] && kill "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null || true
  rm -f "$PIDF" 2>/dev/null || true
  # rete di sicurezza: elimina eventuali overlay orfani
  pkill -f "$OVERLAY" 2>/dev/null || true
}

_save() { mkdir -p "$CFG"; printf '%s\n' "$1" > "$STATE"; }
_is_on() { [ -f "$STATE" ] && [ "$(cat "$STATE" 2>/dev/null)" = "on" ]; }

case "${1:-status}" in
  on)      _start; _save on;  echo "night-light: ON" ;;
  off)     _stop;  _save off; echo "night-light: OFF" ;;
  toggle)  if _running; then "$0" off; else "$0" on; fi ;;
  status)  _running && echo on || echo off ;;
  restore) _is_on && _start || true ;;
  *) echo "uso: nxs-nightlight {on|off|toggle|status|restore}" >&2; exit 2 ;;
esac
