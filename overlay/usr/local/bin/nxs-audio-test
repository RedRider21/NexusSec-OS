#!/bin/sh
# NexusSec - test audio: riproduce un breve brano di prova ATTRAVERSO PipeWire,
# per verificare l'uscita audio senza dipendere dal browser.
#   nxs-audio-test            -> riproduce ~/Music/nxs-audio-test.wav
#   nxs-audio-test --tones    -> speaker-test (dice "Front Left/Right": verifica stereo)
# aplay passa dal plugin ALSA di PipeWire (pipewire-alsa) -> esce da PipeWire.

FILE="$HOME/Music/nxs-audio-test.wav"
[ -f "$FILE" ] || FILE=/home/nexus/Music/nxs-audio-test.wav

tones() {
  if command -v speaker-test >/dev/null 2>&1; then
    echo "Test stereo (speaker-test): dovresti sentire 'Front Left' e 'Front Right'."
    speaker-test -c2 -twav -l1
  else
    echo "speaker-test non disponibile (manca alsa-utils)."
    return 1
  fi
}

play() {
  [ -f "$FILE" ] || { echo "File di test assente: $FILE"; return 1; }
  echo "Riproduco: $FILE"
  if   command -v pw-play >/dev/null 2>&1; then pw-play "$FILE"
  elif command -v aplay   >/dev/null 2>&1; then aplay -q "$FILE"
  elif command -v mpv     >/dev/null 2>&1; then mpv --no-video --really-quiet "$FILE"
  else echo "Nessun player audio (aplay/pw-play/mpv)."; return 127
  fi
}

case "$1" in
  --tones|-t) tones ;;
  *)
    if play; then
      echo "Fatto. Se NON hai sentito nulla:"
      echo "  - controlla volume/mute nel pannello (icona audio) o: nxs-audio get"
      echo "  - prova il test stereo:  nxs-audio-test --tones"
    else
      echo "Riproduzione fallita, provo il test a toni..."
      tones
    fi ;;
esac
