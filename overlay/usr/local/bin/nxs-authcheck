#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di NexusSec OS.
# nxs-authcheck <utente> - verifica la password (letta da STDIN) contro /etc/shadow.
#
# Ritorna:  0 = password corretta · 1 = errata/account senza password ·
#           2 = errore (serve root, utente assente, ecc.)
#
# La password NON passa MAI da argv (solo stdin). Alpine di base NON usa PAM:
# verifichiamo l'hash shadow con crypt(3) di libc via ctypes -> robusto anche
# sulle versioni di Python che hanno rimosso il modulo 'crypt' (dep. dal 3.11,
# rimosso nel 3.13). Richiede privilegi di root per leggere /etc/shadow.
import ctypes
import sys


def _crypt(key: str, setting: str):
    for name in (None, "libc.so", "libcrypt.so.1", "libcrypt.so"):
        try:
            lib = ctypes.CDLL(name)
            lib.crypt.restype = ctypes.c_char_p
            lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
            r = lib.crypt(key.encode(), setting.encode())
            if r:
                return r.decode()
        except (OSError, AttributeError, ValueError):
            continue
    return None


def main():
    user = sys.argv[1] if len(sys.argv) > 1 else "nexus"
    pw = sys.stdin.readline().rstrip("\n")
    h = None
    try:
        with open("/etc/shadow") as f:
            for line in f:
                parts = line.split(":")
                if parts and parts[0] == user:
                    h = parts[1]
                    break
    except PermissionError:
        sys.stderr.write("nxs-authcheck: servono privilegi di root.\n")
        return 2
    except OSError:
        return 2
    if h is None:
        return 2                              # utente non trovato
    if h == "" or h.startswith("!") or h == "*":
        return 1                              # nessuna password / account bloccato
    c = _crypt(pw, h)
    return 0 if (c is not None and c == h) else 1


if __name__ == "__main__":
    sys.exit(main())
