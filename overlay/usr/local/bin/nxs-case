#!/bin/sh
# NexusSec OS - casi forensi: acquisizione, verifica, analisi e relazione.
#
# Fa quello che Autopsy aggiunge sopra The Sleuth Kit - gestione del caso,
# catena di custodia, relazione - senza portarsi dietro Java: i motori sono
# ewfacquire/ewfverify (libewf) e mmls/fls/mactime (sleuthkit), gia' sul media.
#
# Ogni operazione si registra DA SOLA nella catena di custodia con orario UTC,
# versione dello strumento e hash: il verbale non dipende da cosa ci si ricorda
# di annotare.
for c in python3 python3.12 python3.11 python3.10; do
  if command -v "$c" >/dev/null 2>&1; then
    exec env GTK_IM_MODULE=gtk-im-context-simple \
         PYTHONPATH="/usr/local/lib${PYTHONPATH:+:$PYTHONPATH}" \
         "$c" -m nxs_case "$@"
  fi
done
echo "nxs-case: python3 non disponibile" >&2
exit 1
