#!/bin/sh
# NexusSec OS - splash di avvio a schermo intero (GTK3, animata).
for c in python3 python3.11 python3.9 python3.7; do
  if command -v "$c" >/dev/null 2>&1; then
    exec env GTK_IM_MODULE=gtk-im-context-simple PYTHONPATH=/usr/local/lib \
         "$c" -m nxs_cc.bootsplash "$@"
  fi
done
echo "nxs-boot-splash: python3 non disponibile" >&2
exit 1
