#!/bin/sh
# NexusSec - registratore vocale (GTK3 + Cairo). Cattura dal microfono con
# arecord (alsa-utils, gia' nella base; instradato via il bridge ALSA di
# PipeWire), forma d'onda live e salvataggio WAV. Log in /tmp per diagnostica.
LOG=/tmp/nxs-recorder.log
for c in python3 python3.12 python3.11 python3.10; do
  if command -v "$c" >/dev/null 2>&1; then
    exec env GTK_IM_MODULE=gtk-im-context-simple \
         PYTHONPATH="/usr/local/lib${PYTHONPATH:+:$PYTHONPATH}" \
         "$c" -m nxs_recorder "$@" >>"$LOG" 2>&1
  fi
done
echo "nxs-recorder: python3 non disponibile" >&2
exit 1
