#!/bin/sh
# NexusSec Browser - launcher (Alpine).
#
# Il browser e' Python GTK3 + WebKit2 (in /usr/local/lib/nxs_browser). Su
# Alpine il motore web e' il pacchetto apk 'webkit2gtk-4.1'.
#
# DAL 2026.08.25 e' PREINSTALLATO nell'ISO (dipendenza di nexussec-base): il
# primo avvio e' ISTANTANEO e funziona OFFLINE. Prima era on-demand via apk:
# scaricava ~50MB alla prima apertura ("ci mette un secolo") e da chiavetta
# senza rete NON partiva affatto. I blocchi apk qui sotto restano SOLO come
# fallback (se webkit manca) e, se e' gia' presente, sono no-op immediati.
#
# Tutto l'output (errori inclusi) va in /tmp/nxs-browser.log per diagnostica.
set -e
LOG=/tmp/nxs-browser.log
# In Alpine il pacchetto NON e' "webkit2gtk" (non esiste) ma "webkit2gtk-4.1"
# (fornisce WebKit2-4.1.typelib). Usarlo, altrimenti apk add fallisce sempre.
PKG=webkit2gtk-4.1
# Codec media (GStreamer): senza questi la pagina CARICA ma il play NON produce
# audio/video (es. YouTube Music: clic su play e non parte nulla). good+bad+libav
# coprono VP8/VP9/H.264/AAC/Opus/MP3. Installati on-demand INSIEME a WebKit.
MEDIA_PKGS="gst-plugins-good gst-plugins-bad gst-libav"

# Ambiente robusto per WebKit2 su X minimale/VM/live (niente GPU/GL reale):
#  - GTK_IM_MODULE simple: evita il crash da modulo input-method assente.
#  - WEBKIT_DISABLE_DMABUF_RENDERER=1: DISATTIVA il renderer DMABUF. E' LA causa
#    principale del "freeze improvviso a meta' pagina" (es. YouTube Music) su
#    stack SENZA GPU vera: WebKitGTK recente condivide i buffer di rendering via
#    DMABUF, che sull'efifb/software si impianta e blocca l'intero web process.
#  - WEBKIT_DISABLE_COMPOSITING_MODE=1: niente compositing accelerato (no GL).
#  - LIBGL_ALWAYS_SOFTWARE=1 + GALLIUM_DRIVER=llvmpipe: rendering software
#    deterministico se mesa c'e' (niente tentativi GL hardware che si piantano).
#  - GST_GL_DISABLED=1: la pipeline media di WebKit (GStreamer) NON usa il sink
#    GL -> l'audio/video (YouTube Music) non si blocca sul sink GL assente.
#  - WEBKIT_FORCE_SANDBOX=0: il sandbox a user-namespace puo' non essere
#    disponibile e impedirebbe l'avvio del web process.
IMENV="GTK_IM_MODULE=gtk-im-context-simple \
WEBKIT_DISABLE_DMABUF_RENDERER=1 \
WEBKIT_DISABLE_COMPOSITING_MODE=1 \
LIBGL_ALWAYS_SOFTWARE=1 \
GALLIUM_DRIVER=llvmpipe \
GST_GL_DISABLED=1 \
WEBKIT_FORCE_SANDBOX=0"

priv() { if command -v doas >/dev/null 2>&1; then doas "$@"; \
         elif command -v sudo >/dev/null 2>&1; then sudo "$@"; else "$@"; fi; }

have_webkit() {
  for d in /usr/lib/girepository-1.0 /usr/local/lib/girepository-1.0; do
    [ -f "$d/WebKit2-4.1.typelib" ] || [ -f "$d/WebKit2-4.0.typelib" ] && return 0
  done
  return 1
}

if ! have_webkit; then
  echo "NexusSec Browser: installo WebKit2 con apk (solo la prima volta)..." | tee -a "$LOG" >&2
  # SOLO WebKit qui: apk e' ATOMICO, quindi unire i codec media alla stessa
  # transazione faceva fallire TUTTO l'install (browser incluso) se anche solo
  # un pacchetto gst non si risolveva -> il browser non partiva piu'. WebKit va
  # installato per conto suo e DEVE riuscire.
  priv apk add --no-cache "$PKG" >>"$LOG" 2>&1 || true
fi

if ! have_webkit; then
  MSG="WebKit2 non disponibile: impossibile avviare NexusSec Browser. Vedi $LOG"
  echo "$MSG" >&2
  command -v xmessage >/dev/null 2>&1 && xmessage -center "$MSG"
  exit 1
fi

# Codec media (GStreamer), best-effort e SEPARATI da WebKit: senza questi la
# pagina carica ma il play non produce audio/video. Li installiamo UNO ALLA
# VOLTA (non in blocco) cosi' un pacchetto assente in un repo non fa fallire gli
# altri e, soprattutto, NON tocca piu' l'avvio del browser. Marker: se libav e'
# gia' presente, non ritentiamo a ogni avvio.
if [ ! -f /usr/lib/gstreamer-1.0/libgstlibav.so ]; then
  echo "NexusSec Browser: installo i codec media (best-effort)..." | tee -a "$LOG" >&2
  for m in $MEDIA_PKGS; do
    priv apk add --no-cache "$m" >>"$LOG" 2>&1 || true
  done
fi

# Il browser e' STEALTH di default (anonimo via Tor). Serve il binario 'tor':
# lo installiamo on-demand (best-effort). Senza, il browser resta usabile ma
# senza anonimato di IP (badge "Stealth (no Tor)"); il demone lo avvia da se'
# in user-space (SOCKS 9050, data-dir in ~/.nxs-browser/tor).
if ! command -v tor >/dev/null 2>&1; then
  echo "NexusSec Browser: installo Tor per la modalita' stealth..." | tee -a "$LOG" >&2
  priv apk add --no-cache tor >>"$LOG" 2>&1 || true
fi

if command -v python3 >/dev/null 2>&1; then
  exec env $IMENV PYTHONPATH=/usr/local/lib python3 -m nxs_browser "$@" >>"$LOG" 2>&1
fi
echo "nxs-browser: python3 non disponibile (apk add python3)" >&2
exit 1
