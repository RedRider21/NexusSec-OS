#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di NexusSec OS.
# NexusSec - installazione su disco / persistenza (Alpine).
#
# Tre modi per NON perdere l'arsenale (immagini container/kali) al riavvio:
#  A) DISCO INTERO: il sistema prende tutto il disco. Persistenza completa,
#     ma cancella qualunque cosa ci sia sopra.
#  B) A FIANCO: si installa in UNA partizione (esistente o ricavata dallo
#     spazio libero) lasciando intatto il resto, Windows compreso.
#  C) PERSISTENZA LIVE: resti da live e salvi solo arsenale + stato su una
#     partizione dati NXSDATA (nxs-persist).
#
# L'elenco dei dischi arriva da nxs-disks, cosi' si vede COSA c'e' sopra prima
# di scriverci: "setup-disk -m sys DISCO" usa il disco senza chiedere nulla.
priv() { if [ "$(id -u)" = 0 ]; then "$@"; \
         elif command -v doas >/dev/null 2>&1; then doas "$@"; \
         else sudo "$@"; fi; }

elenco_dischi() {
  if command -v nxs-disks >/dev/null 2>&1; then
    nxs-disks --lista-completa
  else
    lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINT 2>/dev/null
  fi
}

# Chiede conferma facendo RISCRIVERE il percorso: un Invio distratto non deve
# poter cancellare un disco di sistema.
conferma_percorso() {
  printf "  Per confermare riscrivi il percorso completo (%s): " "$1"
  read c
  [ "$c" = "$1" ]
}

# Pausa per far leggere l'output prima di tornare al menu. Senza questo (e senza
# il ciclo sotto) lo script terminava dopo ogni scelta e nxs-term CHIUDEVA il
# terminale di colpo: l'utente che sceglieva "mostra dischi" non vedeva nulla e
# sembrava un errore. Ora le azioni informative tornano al menu.
pausa() { printf "\n  Premi Invio per tornare al menu..."; read _ 2>/dev/null; }

# Un disco e' il SUPPORTO DI AVVIO della live (da NON offrire mai): ha una
# partizione iso9660/squashfs, o e' montato sotto /media o /.modloop.
_e_supporto_live() {                    # $1 = /dev/sdX disco
  _d="$1"
  for _n in "$_d" $(lsblk -rno NAME "$_d" 2>/dev/null | tail -n +2 | sed 's|^|/dev/|'); do
    case "$(lsblk -no FSTYPE "$_n" 2>/dev/null | grep -v '^$' | head -1)" in
      iso9660|squashfs) return 0 ;;
    esac
    case "$(lsblk -no MOUNTPOINT "$_n" 2>/dev/null | grep -v '^$' | head -1)" in
      /media/*|/.modloop*) return 0 ;;
    esac
  done
  return 1
}

# Selettore di DISCO a numero (come nxs-persist): niente piu' /dev/sdX digitato
# a mano = niente errori di battitura. I messaggi vanno su STDERR cosi' la
# cattura $(scegli_disco) prende SOLO il device scelto. Vuoto + stato !=0 se
# l'utente annulla o non c'e' nulla di installabile.
scegli_disco() {
  _lf="$(mktemp 2>/dev/null || echo /tmp/nxs-install.disks.$$)"; : > "$_lf"
  for _d in $(lsblk -rno NAME,TYPE 2>/dev/null | awk '$2=="disk"{print $1}'); do
    case "$_d" in zram*|loop*|sr*|fd*) continue ;; esac
    _dd="/dev/$_d"
    _e_supporto_live "$_dd" && continue
    _sz="$(lsblk -dno SIZE "$_dd" 2>/dev/null | head -1)"
    _md="$(lsblk -dno MODEL "$_dd" 2>/dev/null | head -1 | sed 's/[[:space:]]*$//')"
    _tr="$(lsblk -dno TRAN "$_dd" 2>/dev/null | head -1)"
    printf '%s\t%s\t%s\t%s\n' "$_dd" "$_sz" "$_tr" "$_md" >> "$_lf"
  done
  if [ ! -s "$_lf" ]; then
    echo "  Nessun disco installabile rilevato (il supporto di avvio della live" >&2
    echo "  e' escluso di proposito). Collega il disco di destinazione e riprova." >&2
    rm -f "$_lf"; return 1
  fi
  {
    echo "  Dischi su cui installare (il supporto di avvio della live e' escluso):"
    _n=0
    while IFS="$(printf '\t')" read -r _dev _size _tran _model; do
      _n=$((_n + 1)); _hint=""; [ "$_tran" = "usb" ] && _hint="  (USB)"
      printf "   [%d] %-13s %8s  %s%s\n" "$_n" "$_dev" "$_size" "${_model:-disco}" "$_hint"
    done < "$_lf"
    echo "   [0] annulla"
    printf "  Scegli un numero: "
  } >&2
  read _sel
  case "$_sel" in ''|*[!0-9]*) rm -f "$_lf"; return 1 ;; esac
  [ "$_sel" = 0 ] && { rm -f "$_lf"; return 1; }
  _chosen="$(sed -n "${_sel}p" "$_lf" | cut -f1)"
  rm -f "$_lf"
  [ -n "$_chosen" ] || { echo "  scelta non valida." >&2; return 1; }
  echo "$_chosen"
}

# Selettore di DESTINAZIONE a numero per l'installazione "a fianco": elenca le
# partizioni formattabili del disco $1 + l'eventuale spazio libero. Stampa su
# STDOUT il percorso della partizione scelta, oppure la parola "libero".
scegli_destinazione() {                 # $1 = disco
  _disk="$1"
  _lf="$(mktemp 2>/dev/null || echo /tmp/nxs-install.dest.$$)"; : > "$_lf"
  nxs-disks --partizioni 2>/dev/null | grep "^$_disk" \
    | while IFS="$(printf '\t')" read -r _p _psz _pfs _plab _pmp; do
        printf 'part\t%s\t%s\t%s\t%s\n' "$_p" "$_psz" "$_pfs" "$_plab" >> "$_lf"
      done
  _libero="$(nxs-disks --liberi "$_disk" 2>/dev/null | head -1)"
  [ -n "$_libero" ] && printf 'free\t%s\n' "$_libero" >> "$_lf"
  if [ ! -s "$_lf" ]; then
    echo "  Su $_disk non ci sono partizioni formattabili ne' spazio libero >= 2 GiB." >&2
    echo "  Per fare spazio riduci Windows DA WINDOWS (Gestione disco)." >&2
    rm -f "$_lf"; return 1
  fi
  {
    echo
    echo "  Destinazioni su $_disk (scegli a numero):"
    _n=0
    while IFS="$(printf '\t')" read -r _k _a _b _c _d; do
      _n=$((_n + 1))
      if [ "$_k" = free ]; then
        printf "   [%d] spazio libero ~%s  ->  creo una partizione nuova (il resto resta intatto)\n" "$_n" "$_c"
      else
        printf "   [%d] %-13s %8s  %-8s %s  (verra' FORMATTATA)\n" "$_n" "$_a" "$_b" "${_c:--}" "${_d}"
      fi
    done < "$_lf"
    echo "   [0] annulla"
    printf "  Scegli un numero: "
  } >&2
  read _sel
  case "$_sel" in ''|*[!0-9]*) rm -f "$_lf"; return 1 ;; esac
  [ "$_sel" = 0 ] && { rm -f "$_lf"; return 1; }
  _row="$(sed -n "${_sel}p" "$_lf")"
  rm -f "$_lf"
  [ -n "$_row" ] || { echo "  scelta non valida." >&2; return 1; }
  _kind="$(printf '%s' "$_row" | cut -f1)"
  if [ "$_kind" = free ]; then echo "libero"; else printf '%s' "$_row" | cut -f2; fi
}

# Il menu gira in CICLO: le voci informative (d, 5) e gli annullamenti tornano
# al menu; solo l'installazione vera (exec ...) o 'q' escono.
while :; do
echo
echo "==============================================================="
echo "  NexusSec OS - installazione su disco / persistenza"
echo "==============================================================="
echo
echo "  A) INSTALLA SU DISCO (persistenza completa e automatica)"
echo "     1) guidata      setup-alpine: configurazione completa"
echo "     2) disco intero installa prendendo TUTTO il disco"
echo "     3) a fianco     installa in una partizione, lascia il resto"
echo
echo "  B) PERSISTENZA LIVE (resti live, salvi arsenale + stato + credenziali)"
echo "     4) nxs-persist  crea la partizione dati NXSDATA"
echo "     5) stato persistenza"
echo
echo "     d) mostra dischi e partizioni"
echo "     q) annulla"
printf "  Scelta: "; read ans
echo

case "$ans" in
  d) echo "  Dischi e partizioni (sola lettura, niente viene montato):"; echo
     elenco_dischi || echo "  (impossibile leggere i dischi)"
     pausa; continue ;;

  1) exec priv setup-alpine ;;

  2) disk="$(scegli_disco)" || { pausa; continue; }
     [ -n "$disk" ] || { pausa; continue; }
     [ -b "$disk" ] || { echo "  ERRORE: $disk non e un dispositivo a blocchi."; pausa; continue; }
     echo
     echo "  =========================================================="
     echo "  ATTENZIONE: contenuto ATTUALE di $disk"
     echo "  =========================================================="
     lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT "$disk" 2>/dev/null
     echo
     echo "  Tutto quanto elencato sopra verra CANCELLATO."
     echo "  Se su questo disco c e Windows o un altro Linux da tenere,"
     echo "  annulla e usa la scelta 3 (a fianco)."
     echo
     conferma_percorso "$disk" || { echo "  Non confermato: non e stato toccato nulla."; pausa; continue; }
     echo "  Dopo l installazione lo storage Podman sara su disco:"
     echo "  l arsenale scaricato restera tra i riavvii."
     exec priv setup-disk -m sys "$disk"
     ;;

  3) # --- installazione A FIANCO ------------------------------------------
     disk="$(scegli_disco)" || { pausa; continue; }
     [ -n "$disk" ] || { pausa; continue; }
     [ -b "$disk" ] || { echo "  ERRORE: $disk non e un dispositivo a blocchi."; pausa; continue; }
     # Spazio libero del disco: serve al ramo 'libero' qui sotto (inizio/fine).
     libero="$(nxs-disks --liberi "$disk" 2>/dev/null)"
     dest="$(scegli_destinazione "$disk")" || { pausa; continue; }
     [ -n "$dest" ] || { pausa; continue; }

     if [ "$dest" = "libero" ]; then
       [ -n "$libero" ] || { echo "  Non c e spazio libero utilizzabile."; pausa; continue; }
       ini=$(printf '%s\n' "$libero" | head -1 | cut -f1)
       fin=$(printf '%s\n' "$libero" | head -1 | cut -f2)
       dimh=$(printf '%s\n' "$libero" | head -1 | cut -f3)
       echo
       echo "  Verra creata una partizione nuova di circa $dimh su $disk."
       echo "  Le partizioni esistenti NON vengono toccate."
       printf "  Confermi? scrivi  si  : "; read c
       [ "$c" = "si" ] || { echo "  Annullato."; pausa; continue; }
       # Identifichiamo la partizione NUOVA confrontando l elenco prima/dopo:
       # parted non ne stampa il nome in modo affidabile su tutti i backend.
       tp=$(mktemp); td=$(mktemp)
       lsblk -ln -o NAME "$disk" | sort > "$tp"
       priv parted -s "$disk" mkpart primary ext4 "${ini}B" "${fin}B" || {
         rm -f "$tp" "$td"; echo "  ERRORE: creazione della partizione fallita."; pausa; continue; }
       priv partprobe "$disk" 2>/dev/null || true
       sleep 2
       lsblk -ln -o NAME "$disk" | sort > "$td"
       nuova=$(comm -13 "$tp" "$td" | head -1)
       rm -f "$tp" "$td"
       [ -n "$nuova" ] || { echo "  ERRORE: non riesco a identificare la partizione nuova."; pausa; continue; }
       dest="/dev/$nuova"
       echo "  Creata: $dest"
     else
       [ -b "$dest" ] || { echo "  ERRORE: $dest non e una partizione."; pausa; continue; }
       case "$(lsblk -no MOUNTPOINT "$dest" 2>/dev/null | tr -d ' ')" in
         /|/boot|/boot/efi) echo "  ERRORE: $dest e in uso dal sistema corrente."; pausa; continue ;;
       esac
       echo
       echo "  =========================================================="
       echo "  $dest verra FORMATTATA: il suo contenuto andra perso."
       echo "  Il RESTO del disco (Windows, altri Linux, dati) resta intatto."
       echo "  =========================================================="
       lsblk -o NAME,SIZE,FSTYPE,LABEL "$dest" 2>/dev/null
       echo
       conferma_percorso "$dest" || { echo "  Non confermato: non e stato toccato nulla."; pausa; continue; }
     fi

     echo "  Formattazione di $dest in ext4..."
     priv mkfs.ext4 -q -L NEXUSSEC "$dest" || { echo "  ERRORE: formattazione fallita."; pausa; continue; }
     priv mkdir -p /mnt
     priv mount "$dest" /mnt || { echo "  ERRORE: montaggio di $dest fallito."; pausa; continue; }
     echo
     echo "  Installazione del sistema in $dest, bootloader su $disk."
     echo "  NOTA: il menu di avvio potrebbe non elencare Windows da solo"
     echo "  (Alpine non installa os-prober). Windows resta comunque avviabile"
     echo "  dal menu di avvio del firmware (di solito F12 / F9 / Esc)."
     echo
     exec priv setup-disk -m sys -b "$disk" /mnt
     ;;

  4) exec nxs-persist ;;
  5) nxs-persist status; pausa; continue ;;
  q|Q) echo "  annullato."; exit 0 ;;
  "") continue ;;
  *) echo "  scelta non valida: scrivi una delle lettere/numeri elencati."; pausa; continue ;;
esac
done
