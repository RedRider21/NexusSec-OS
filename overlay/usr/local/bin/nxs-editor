# nxs-editor - editor di testo e di codice nativo (GTK3 + GtkSourceView 4).
# Sostituisce pluma: interamente in casa. Accetta file da aprire e +RIGA.
for c in python3 python3.11 python3.12 python3.10; do
  if command -v "$c" >/dev/null 2>&1; then
    exec env PYTHONPATH=/usr/local/lib "$c" -m nxs_editor "$@"
  fi
done
echo "nxs-editor: python3 non disponibile" >&2
exit 1
