#!/bin/sh
# nxs-prompt - stile del prompt del terminale, COMMUTABILE da configurazione.
# La scelta e' salvata in ~/.config/nxs/prompt e letta da ~/.config/nxs/shrc
# (bash via ~/.bashrc, ash via $ENV). Ha effetto sui NUOVI terminali.
#
#   nxs-prompt get                 stampa lo stile attivo
#   nxs-prompt list                elenca gli stili
#   nxs-prompt set <stile>         default | parrot | plain
set -eu
CONF="$HOME/.config/nxs/prompt"

case "${1:-get}" in
  get)
    [ -r "$CONF" ] && cat "$CONF" || echo default ;;
  list)
    echo "default  prompt NexusSec a una riga (accent ciano)"
    echo "parrot   due righe stile Parrot: ┌──[user@host]─[dir] / └──╼"
    echo "plain    minimale: user@host:dir\$" ;;
  set)
    st="${2:-}"
    case "$st" in
      default|parrot|plain) ;;
      *) echo "stile non valido: '$st' (usa: nxs-prompt list)" >&2; exit 1 ;;
    esac
    mkdir -p "$(dirname "$CONF")"
    printf '%s\n' "$st" > "$CONF"
    echo "prompt impostato: $st (apri un nuovo terminale per vederlo)" ;;
  *)
    echo "uso: nxs-prompt [get|list|set <default|parrot|plain>]" >&2; exit 2 ;;
esac
