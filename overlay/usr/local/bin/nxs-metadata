#!/bin/sh
# nxs-metadata - rimozione metadati con MAT2 (Metadata Anonymisation Toolkit).
#
# I file (foto, PDF, documenti office, audio/video...) contengono metadati che
# possono rivelare identita' e posizione (GPS nelle foto, autore nei PDF, date,
# software usato). Prima di condividere un file sotto copertura vanno ripuliti.
# MAT2 crea una COPIA ripulita (<nome>.cleaned.<est>) senza toccare l'originale.
#
# Uso:
#   nxs-metadata show  FILE            mostra i metadati presenti
#   nxs-metadata clean FILE [FILE...]  crea copie ripulite
#   nxs-metadata gui  [FILE...]        pulisce i file dati (da file manager) o,
#                                      senza argomenti, apre un selettore grafico
set -u

_notify() {
  if command -v notify-send >/dev/null 2>&1; then notify-send "NexusSec — Metadati" "$1"
  elif command -v xmessage >/dev/null 2>&1; then printf '%s\n' "$1" | xmessage -center -file - -timeout 8 2>/dev/null &
  else echo "$1"; fi
}

_have_mat2() {
  command -v mat2 >/dev/null 2>&1 && return 0
  # fallback: prova a installarlo (sul live e' preinstallato via nexussec-base)
  if command -v doas >/dev/null 2>&1; then doas apk add --no-cache mat2 >/dev/null 2>&1; fi
  command -v mat2 >/dev/null 2>&1
}

_clean() {
  ok=0; fail=0
  for f in "$@"; do
    [ -f "$f" ] || { fail=$((fail+1)); continue; }
    if mat2 --inplace "$f" >/dev/null 2>&1 || mat2 "$f" >/dev/null 2>&1; then
      ok=$((ok+1))
    else
      fail=$((fail+1))
    fi
  done
  if [ "$fail" = 0 ]; then _notify "Ripuliti $ok file (copie *.cleaned accanto agli originali)."
  else _notify "Ripuliti $ok file, $fail non elaborati."; fi
}

case "${1:-}" in
  show)
    shift; [ -n "${1:-}" ] || { echo "uso: nxs-metadata show FILE" >&2; exit 2; }
    _have_mat2 || { echo "mat2 non disponibile." >&2; exit 1; }
    mat2 --show "$@"
    ;;
  clean)
    shift; [ -n "${1:-}" ] || { echo "uso: nxs-metadata clean FILE [FILE...]" >&2; exit 2; }
    _have_mat2 || { _notify "mat2 non disponibile."; exit 1; }
    _clean "$@"
    ;;
  gui)
    shift
    _have_mat2 || { _notify "mat2 non disponibile."; exit 1; }
    if [ "$#" -gt 0 ]; then
      _clean "$@"
    else
      # selettore grafico multi-file (GTK3)
      files=$(PYTHONPATH="/usr/local/lib${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
d = Gtk.FileChooserDialog(title="Scegli i file da ripulire (metadati)",
                          action=Gtk.FileChooserAction.OPEN)
d.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
              Gtk.STOCK_OK, Gtk.ResponseType.OK)
d.set_select_multiple(True)
sel = d.get_filenames() if d.run() == Gtk.ResponseType.OK else []
d.destroy()
print("\n".join(sel))
PY
)
      [ -n "$files" ] || exit 0
      # shellcheck disable=SC2086
      OLDIFS=$IFS; IFS='
'
      set -- $files; IFS=$OLDIFS
      _clean "$@"
    fi
    ;;
  *)
    echo "uso: nxs-metadata {show FILE | clean FILE... | gui [FILE...]}" >&2
    exit 2 ;;
esac
