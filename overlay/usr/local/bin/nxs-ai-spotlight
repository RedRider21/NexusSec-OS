#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di NexusSec OS.
# NexusSec OS - Spotlight dell'assistente IA (finestra rapida, hotkey Super+A).
# Se una finestra spotlight e' gia' aperta, la porta in primo piano invece di
# aprirne un'altra.
if command -v wmctrl >/dev/null 2>&1 && wmctrl -l 2>/dev/null | grep -q "Assistente IA"; then
  wmctrl -a "Assistente IA" 2>/dev/null && exit 0
fi
for c in python3 python3.9 python3.11 python3.7; do
  if command -v "$c" >/dev/null 2>&1; then
    exec env GTK_IM_MODULE=gtk-im-context-simple PYTHONPATH=/usr/local/lib "$c" -m nxs_ai.spotlight "$@"
  fi
done
echo "nxs-ai-spotlight: python3 non disponibile" >&2
exit 1
