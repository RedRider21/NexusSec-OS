#!/bin/sh
# nxs-bluetooth - controllo Bluetooth via bluetoothctl (BlueZ). Usato dal widget
# del pannello e dalla finestra "Gestione Bluetooth" del Centro di Controllo.
# Best-effort: senza adattatore stampa "noadapter" senza errori.
_have() { command -v bluetoothctl >/dev/null 2>&1; }

# Deduce un nome-icona simbolica dal campo "Icon" di bluetoothctl info.
_devicon() {
  case "$1" in
    *audio*|*headset*|*headphone*|*speaker*) echo "audio-headphones-symbolic" ;;
    *input-keyboard*|*keyboard*)             echo "input-keyboard-symbolic" ;;
    *input-mouse*|*mouse*)                   echo "input-mouse-symbolic" ;;
    *input-gaming*|*joypad*|*gamepad*)       echo "input-gaming-symbolic" ;;
    *phone*)                                 echo "phone-symbolic" ;;
    *computer*)                              echo "computer-symbolic" ;;
    *printer*)                               echo "printer-symbolic" ;;
    *) echo "bluetooth-symbolic" ;;
  esac
}

# elenca i device: "mac<TAB>nome<TAB>stato(conn|paired|"")<TAB>trusted(1|0)<TAB>icona"
# Il NOME va preso da `info` (Alias/Name), non dalla riga `devices`: quest'ultima
# resta il MAC (es. "XX-XX-XX-XX-XX-XX") finche' il device non ha comunicato il
# suo nome. Alias e' il nome mostrato all'utente (Name se non rinominato).
_list_devices() {
  bluetoothctl devices 2>/dev/null | while read -r _dev mac name; do
    [ -n "$mac" ] || continue
    info=$(bluetoothctl info "$mac" 2>/dev/null)
    st=""
    echo "$info" | grep -q "Connected: yes" && st="conn"
    [ -z "$st" ] && echo "$info" | grep -q "Paired: yes" && st="paired"
    tr=0; echo "$info" | grep -q "Trusted: yes" && tr=1
    ic=$(_devicon "$(echo "$info" | sed -n 's/^[[:space:]]*Icon:[[:space:]]*//p')")
    alias=$(echo "$info" | sed -n 's/^[[:space:]]*Alias:[[:space:]]*//p' | head -1)
    rname=$(echo "$info" | sed -n 's/^[[:space:]]*Name:[[:space:]]*//p' | head -1)
    # nome mostrato: Alias -> Name -> nome della riga devices -> MAC.
    disp="$alias"; [ -n "$disp" ] || disp="$rname"
    [ -n "$disp" ] || disp="$name"
    # se e' ancora un MAC "travestito" (XX-XX-... o == mac), usa il MAC pulito
    case "$disp" in
      "" | "$mac") disp="$mac" ;;
      [0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f]-*) disp="$mac" ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\n' "$mac" "$disp" "$st" "$tr" "$ic"
  done
}

case "${1:-status}" in
  status)
    # "noadapter" | "off" | "on" | "conn" (acceso E con un device connesso).
    _have || { echo noadapter; exit 0; }
    show=$(bluetoothctl show 2>/dev/null)
    [ -z "$show" ] && { echo noadapter; exit 0; }
    echo "$show" | grep -q "Powered: yes" || { echo off; exit 0; }
    connected=$(bluetoothctl devices 2>/dev/null | while read -r _dev mac _name; do
      [ -n "$mac" ] || continue
      bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes" && { echo yes; break; }
    done)
    [ -n "$connected" ] && echo conn || echo on
    ;;
  adapter)
    # info adattatore: "nome<TAB>alias<TAB>indirizzo<TAB>powered<TAB>discoverable<TAB>pairable"
    _have || { echo -e "\t\t\t\t\t"; exit 0; }
    show=$(bluetoothctl show 2>/dev/null)
    addr=$(echo "$show" | sed -n 's/^Controller[[:space:]]*\([0-9A-Fa-f:]*\).*/\1/p' | head -1)
    name=$(echo "$show" | sed -n 's/^[[:space:]]*Name:[[:space:]]*//p' | head -1)
    alias=$(echo "$show" | sed -n 's/^[[:space:]]*Alias:[[:space:]]*//p' | head -1)
    pw=0;  echo "$show" | grep -q "Powered: yes" && pw=1
    disc=0; echo "$show" | grep -q "Discoverable: yes" && disc=1
    pair=0; echo "$show" | grep -q "Pairable: yes" && pair=1
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$alias" "$addr" "$pw" "$disc" "$pair"
    ;;
  on)
    command -v rfkill >/dev/null 2>&1 && rfkill unblock bluetooth 2>/dev/null
    _have && bluetoothctl power on >/dev/null 2>&1
    _have && bluetoothctl agent on >/dev/null 2>&1
    _have && bluetoothctl default-agent >/dev/null 2>&1
    _have && bluetoothctl pairable on >/dev/null 2>&1
    ;;
  off) _have && bluetoothctl power off >/dev/null 2>&1 ;;
  discoverable)
    # discoverable on|off (rende l'adattatore visibile ad altri device)
    _have && bluetoothctl discoverable "${2:-on}" >/dev/null 2>&1
    ;;
  alias)
    # rinomina l'adattatore (nome visibile agli altri device)
    shift
    [ -n "${1:-}" ] && _have && bluetoothctl system-alias "$*" >/dev/null 2>&1
    ;;
  scan)
    # scansione breve, poi elenco device (formato esteso a 5 colonne)
    _have || exit 0
    command -v rfkill >/dev/null 2>&1 && rfkill unblock bluetooth 2>/dev/null
    bluetoothctl power on >/dev/null 2>&1
    bluetoothctl agent on >/dev/null 2>&1
    bluetoothctl default-agent >/dev/null 2>&1
    bluetoothctl --timeout "${2:-6}" scan on >/dev/null 2>&1
    _list_devices
    ;;
  devices) _have || exit 0; _list_devices ;;
  info)
    # dettaglio di un device: righe key=value grezze da bluetoothctl info
    [ -n "${2:-}" ] && _have && bluetoothctl info "$2" 2>/dev/null
    ;;
  connect)
    # Connessione robusta: se il device NON e' ancora accoppiato, lo accoppiamo
    # al volo (serve un AGENT attivo durante il pairing, altrimenti i device
    # audio "Just Works" non completano e la connessione non avviene). Poi
    # trust (riconnessione automatica) e infine connect.
    [ -n "${2:-}" ] && _have || exit 0
    mac="$2"
    bluetoothctl power on >/dev/null 2>&1
    if ! bluetoothctl info "$mac" 2>/dev/null | grep -q "Paired: yes"; then
      # sessione unica: l'agent auto-accept resta vivo mentre avviene il pairing
      printf 'agent NoInputNoOutput\ndefault-agent\npair %s\n' "$mac" \
        | bluetoothctl --timeout 15 >/dev/null 2>&1
      bluetoothctl trust "$mac" >/dev/null 2>&1
    fi
    bluetoothctl connect "$mac" 2>&1
    ;;
  disconnect) [ -n "${2:-}" ] && _have && bluetoothctl disconnect "$2" 2>&1 ;;
  pair)
    # Pairing con agent auto-accept mantenuto vivo dalla sessione (--timeout):
    # senza agent i device audio non completano il pairing. Poi trust + connect.
    [ -n "${2:-}" ] && _have || exit 0
    mac="$2"
    bluetoothctl power on >/dev/null 2>&1
    printf 'agent NoInputNoOutput\ndefault-agent\npair %s\n' "$mac" \
      | bluetoothctl --timeout 15 2>&1
    bluetoothctl trust "$mac" >/dev/null 2>&1
    bluetoothctl connect "$mac" >/dev/null 2>&1
    ;;
  trust)      [ -n "${2:-}" ] && _have && bluetoothctl trust "$2" 2>&1 ;;
  untrust)    [ -n "${2:-}" ] && _have && bluetoothctl untrust "$2" 2>&1 ;;
  remove)     [ -n "${2:-}" ] && _have && bluetoothctl remove "$2" 2>&1 ;;
  *) echo "uso: nxs-bluetooth {status|adapter|on|off|discoverable on|off|scan [sec]|devices|info MAC|connect MAC|disconnect MAC|pair MAC|trust MAC|untrust MAC|remove MAC}" >&2; exit 2 ;;
esac
exit 0
