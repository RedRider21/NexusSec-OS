#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di NexusSec OS.
# nxs-lang - lingua dell'interfaccia NexusSec (it/en/fr/es/de).
# La scelta e' salvata in ~/.config/nxs/lang e usata da pannello, Centro di
# Controllo e app che chiamano nxs_i18n.t().
#
#   nxs-lang get              stampa la lingua attiva
#   nxs-lang list             elenca i codici disponibili
#   nxs-lang set <codice>     imposta la lingua e riavvia il pannello
#   nxs-lang sync-menu        menu del tasto destro nella lingua attiva
set -eu
export PYTHONPATH="${PYTHONPATH:-/usr/local/lib}"

# Menu del tasto destro (Openbox) nella lingua $1: si sostituisce SOLO se il
# menu dell'utente e' ancora uno di quelli di serie (qualunque lingua). Se e'
# stato modificato - a mano o con l'editor del menu del Centro di Controllo -
# non si tocca. File di serie generati da build/make-openbox-menus.py.
sync_menu() {
  skel=/usr/local/share/nexussec/openbox-menu
  menu="$HOME/.config/openbox/menu.xml"
  [ -f "$skel/menu.$1.xml" ] || return 0
  # Le icone puntano alla serie tinta col profilo (menu-icons-<profilo>/, vedi
  # nxs_profiles.model.tint_menu_icons): per riconoscere un menu "di serie" il
  # confronto si fa a percorsi icone normalizzati.
  norm="${TMPDIR:-/tmp}/nxs-menu-norm.$$"
  if [ -f "$menu" ]; then
    sed 's#/nexussec/menu-icons-[a-z]*/#/nexussec/menu-icons/#g' "$menu" > "$norm"
    stock=0
    for f in "$skel"/menu.*.xml; do cmp -s "$norm" "$f" && { stock=1; break; }; done
    if [ "$stock" = 1 ] && cmp -s "$norm" "$skel/menu.$1.xml"; then stock=2; fi
    rm -f "$norm"
    [ "$stock" = 1 ] || return 0                          # personalizzato o gia' giusto
  fi
  mkdir -p "$(dirname "$menu")"
  cp "$skel/menu.$1.xml" "$menu" 2>/dev/null || return 0
  python3 -c 'from nxs_profiles import model; model.tint_menu_icons()' 2>/dev/null || true
  # Openbox rilegge il menu solo su reconfigure (se non gira, nessun effetto)
  [ -n "${DISPLAY:-}" ] && command -v openbox >/dev/null 2>&1 && openbox --reconfigure 2>/dev/null || true
}

case "${1:-get}" in
  get)
    python3 -c 'import nxs_i18n; print(nxs_i18n.current_lang())'
    ;;
  list)
    python3 -c 'import nxs_i18n
for c in nxs_i18n.LANGS: print(c, nxs_i18n.LANG_NAMES[c])'
    ;;
  set)
    [ -n "${2:-}" ] || { echo "uso: nxs-lang set <it|en|fr|es|de>" >&2; exit 2; }
    python3 -c 'import sys, nxs_i18n; sys.exit(0 if nxs_i18n.set_lang(sys.argv[1]) else 1)' "$2" \
      || { echo "lingua non valida: $2 (usa: nxs-lang list)" >&2; exit 1; }
    echo "lingua impostata: $2"
    sync_menu "$2"
    # Variabili di lingua per i processi che riavviamo (pcmanfm legge i
    # Name[xx]/Comment[xx] dei .desktop tramite LANGUAGE).
    case "$2" in
      en) LC=en_US ;; fr) LC=fr_FR ;; es) LC=es_ES ;; de) LC=de_DE ;; *) LC=it_IT ;;
    esac
    export LANGUAGE="$2" LANG="${LC}.UTF-8"
    # 1) Demone "caldo" (nxs_cc.launcherd): e' RESIDENTE e ha importato i moduli
    #    (e la lingua) al boot -> Centro di Controllo, viste e selettore profili
    #    resterebbero nella vecchia lingua. Va RIAVVIATO perche' riparta pulito.
    if command -v nxs-launcherd >/dev/null 2>&1; then
      pkill -f nxs_cc.launcherd 2>/dev/null || true
      sleep 1
      setsid nxs-launcherd >/tmp/nxs-launcherd.log 2>&1 &
    fi
    # 2) Pannello. pkill DIRETTO (si auto-esclude) e rilancio da launcher separato
    #    il cui argv NON contiene 'nxs_cc.panel'.
    if command -v nxs-panel >/dev/null 2>&1; then
      pkill -f nxs_cc.panel 2>/dev/null || true
      sleep 1
      setsid nxs-panel >/dev/null 2>&1 &
    fi
    # 3) Icone del desktop: pcmanfm sceglie i Name[xx] alla partenza (da LANGUAGE).
    #    Lo riavviamo con la nuova lingua cosi' le etichette cambiano SUBITO
    #    (best-effort: se pcmanfm non c'e', semplicemente non fa nulla).
    if command -v pcmanfm >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
      pkill -f "pcmanfm --desktop" 2>/dev/null || true
      sleep 1
      setsid pcmanfm --desktop --profile=NexusSec >/dev/null 2>&1 &
    fi
    ;;
  sync-menu)
    # allinea il menu del tasto destro alla lingua attiva (usato all'avvio)
    sync_menu "$(python3 -c 'import nxs_i18n; print(nxs_i18n.current_lang())')"
    ;;
  *)
    echo "uso: nxs-lang {get|list|set <codice>|sync-menu}" >&2; exit 2
    ;;
esac
