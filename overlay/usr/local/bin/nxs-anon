#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di NexusSec OS.
# nxs-anon - Modalita' ANONIMA GLOBALE (Tor trasparente + kill-switch).
#
# A differenza di `nxs-tor` (che offre solo un proxy SOCKS 9050 usato dalle app
# proxy-aware, HORUS/browser), qui TUTTO il traffico TCP e le richieste DNS del
# sistema vengono instradati DENTRO Tor in modo trasparente, e ogni altro
# traffico viene BLOCCATO (kill-switch): se Tor cade, la rete si chiude invece di
# uscire in chiaro. Stile AnonSurf/Tails.
#
# Come funziona:
#  - avvia un Tor dedicato come utente 'tor' con TransPort 9040 + DNSPort 5353
#    (+ SocksPort 9050 per le app proxy-aware, se non c'e' gia' un altro Tor)
#    e ControlPort 9052 (solo loopback, cookie) per la "nuova identita'";
#  - nftables: DNAT del DNS -> 5353 e del TCP nuovo -> 9040 (tranne loopback e il
#    traffico dello STESSO utente 'tor', che deve poter uscire verso i relay);
#    l'OUTPUT che non e' loopback o di Tor viene DROPPATO.
#  - IPv6 e UDP (tranne il DNS dirottato e il rinnovo DHCP) vengono bloccati:
#    Tor non li instrada, quindi bloccarli evita leak (comportamento voluto).
#  - 2026-11-28 (confronto con AnonSurf 6): le connessioni GIA' APERTE prima
#    dell'attivazione NON passano piu' in chiaro. Prima l'output accettava ogni
#    connessione "established": una pagina o una chat aperte prima restavano
#    fuori da Tor. Ora fuori da loopback esce solo Tor; le vecchie connessioni
#    TCP ricevono un reset e le app si ricollegano (passando da Tor).
#
# Fail-safe: il kill-switch si applica SOLO dopo che Tor risulta attivo; se Tor
# non parte, si lascia il firewall normale e si esce con errore (niente rete
# "murata" senza anonimato).
#
# Uso:
#   nxs-anon on|off|status|toggle      (default: status)
#   nxs-anon newnym                    nuova identita' (nuovi circuiti Tor)
#   nxs-anon check                     verifica: uscita Tor, DNS, IPv6, kill-switch
#   nxs-anon boot on|off|status        attiva la modalita' a ogni avvio (serve la
#                                      persistenza: la scelta sta in ~/.config/nxs)
#   nxs-anon bridges set|clear|status  bridge obfs4/webtunnel per reti che bloccano
#                                      Tor (set: righe "Bridge" da STDIN)
#
# NB: richiede root (nftables + Tor come utente 'tor'). Sul live e' immediato
# (doas nopass); su sistema hardenizzato doas chiede la password.
set -eu

TRANS_PORT=9040
DNS_PORT=5353
SOCKS_PORT=9050
CTRL_PORT=9052
VIRTNET=10.192.0.0/10
TOR_USER=tor
DATADIR=/var/lib/tor-anon
TORRC=/run/nxs-anon-torrc
# PidFile e Log DENTRO la DataDirectory (di proprieta' dell'utente 'tor'):
# Tor droppa i privilegi a 'tor' e deve poterci scrivere, altrimenti NON parte.
PIDFILE="$DATADIR/tor.pid"
LOG="$DATADIR/tor.log"
STATE=/run/nxs-anon.on
# scelte dell'utente (anche quando gira da root al boot): ~/.config/nxs di nexus,
# che con la persistenza sta sulla parte dati
CONF="${NXS_CONF_DIR:-/home/nexus/.config/nxs}"
BOOTFLAG="$CONF/anon-boot"
BRIDGES="$CONF/tor-bridges"

priv() {
  if [ "$(id -u)" = 0 ]; then "$@"
  elif command -v doas >/dev/null 2>&1; then doas "$@"
  elif command -v sudo >/dev/null 2>&1; then sudo "$@"
  else echo "nxs-anon: servono privilegi di root." >&2; return 1; fi
}

have() { command -v "$1" >/dev/null 2>&1; }

port_up() { netstat -ltn 2>/dev/null | grep -q "127\.0\.0\.1:$1[[:space:]]"; }

is_on() { [ -e "$STATE" ] && port_up "$TRANS_PORT"; }

# righe dei bridge (solo "Bridge ..." valide); vuoto se non configurati
_bridge_lines() {
  [ -r "$BRIDGES" ] || return 0
  sed -n 's/^[[:space:]]*\(Bridge[[:space:]].*\)$/\1/p; s/^[[:space:]]*\(obfs4[[:space:]].*\)$/Bridge \1/p; s/^[[:space:]]*\(webtunnel[[:space:]].*\)$/Bridge \1/p' "$BRIDGES"
}

# --- genera lo script eseguito come root (unico salto di privilegi) ----------
_root_on() {
  # SocksPort solo se la 9050 e' libera: se c'e' gia' il Tor di nxs-tor/browser,
  # le app proxy-aware continuano a usare quello (prima Tor non partiva affatto)
  socks="SocksPort 127.0.0.1:$SOCKS_PORT"
  port_up "$SOCKS_PORT" && socks="# SocksPort: la 9050 e' gia' di un altro Tor"
  bl="$(_bridge_lines)"
  cat <<ROOT
set -eu
command -v nft >/dev/null 2>&1 || { echo "nftables assente"; exit 1; }
# 1) pacchetto tor + utente tor
if ! command -v tor >/dev/null 2>&1; then apk add --no-cache tor >/dev/null 2>&1 || { echo "tor non installabile"; exit 1; }; fi
id "$TOR_USER" >/dev/null 2>&1 || { echo "utente '$TOR_USER' assente"; exit 1; }
TORUID=\$(id -u "$TOR_USER")
mkdir -p "$DATADIR"; chown "$TOR_USER":"$TOR_USER" "$DATADIR"; chmod 700 "$DATADIR"
# 1b) bridge: serve il trasporto (lyrebird, ex obfs4proxy), installato a richiesta
PT=""
if [ -n "$(printf '%s' "$bl" | head -c1)" ]; then
  for b in lyrebird obfs4proxy; do command -v \$b >/dev/null 2>&1 && { PT=\$(command -v \$b); break; }; done
  if [ -z "\$PT" ]; then
    apk add --no-cache lyrebird >/dev/null 2>&1 || apk add --no-cache obfs4proxy >/dev/null 2>&1 || true
    for b in lyrebird obfs4proxy; do command -v \$b >/dev/null 2>&1 && { PT=\$(command -v \$b); break; }; done
  fi
  [ -n "\$PT" ] || { echo "bridge configurati ma lyrebird/obfs4proxy non installabile: NON attivo"; exit 1; }
fi
# 2) torrc trasparente + timeout ottimizzati (come nxs-tor)
cat > "$TORRC" <<TORRC_EOF
User $TOR_USER
DataDirectory $DATADIR
PidFile $PIDFILE
Log notice file $LOG
RunAsDaemon 1
$socks
TransPort 127.0.0.1:$TRANS_PORT
DNSPort 127.0.0.1:$DNS_PORT
ControlPort 127.0.0.1:$CTRL_PORT
CookieAuthentication 1
AutomapHostsOnResolve 1
VirtualAddrNetworkIPv4 $VIRTNET
AvoidDiskWrites 1
CircuitStreamTimeout 15
SocksTimeout 30
CircuitBuildTimeout 12
LearnCircuitBuildTimeout 1
MaxCircuitDirtiness 600
KeepalivePeriod 60
TORRC_EOF
if [ -n "\$PT" ]; then
  { echo "UseBridges 1"
    echo "ClientTransportPlugin obfs4,webtunnel exec \$PT"
    cat <<'BRIDGE_EOF'
$bl
BRIDGE_EOF
  } >> "$TORRC"
fi
# 3) avvia Tor (se non gia' su) e attendi il TransPort
if ! (netstat -ltn 2>/dev/null | grep -q "127\.0\.0\.1:$TRANS_PORT[[:space:]]"); then
  tor -f "$TORRC" >/dev/null 2>&1 || true
fi
i=0
while [ \$i -lt 30 ]; do
  netstat -ltn 2>/dev/null | grep -q "127\.0\.0\.1:$TRANS_PORT[[:space:]]" && break
  sleep 1; i=\$((i+1))
done
if ! (netstat -ltn 2>/dev/null | grep -q "127\.0\.0\.1:$TRANS_PORT[[:space:]]"); then
  echo "Tor non ha aperto il TransPort $TRANS_PORT: NON applico il kill-switch."; exit 2
fi
# 4) kill-switch nftables (solo ORA che Tor e' confermato attivo).
#    Nessun "ct state established accept" in OUTPUT: le connessioni aperte
#    PRIMA restavano in chiaro. Fuori da loopback esce solo l'utente 'tor'
#    (+ rinnovo DHCP, altrimenti alla scadenza del lease si perde la rete);
#    il TCP restante riceve un reset (le app si ricollegano via Tor).
nft -f - <<NFT_EOF
flush ruleset
table ip nxsanon_nat {
  chain output {
    type nat hook output priority -100; policy accept;
    meta skuid \$TORUID return
    oif "lo" return
    ip daddr 127.0.0.0/8 return
    udp dport 53 redirect to :$DNS_PORT
    tcp dport 53 redirect to :$DNS_PORT
    tcp flags syn redirect to :$TRANS_PORT
  }
}
table inet nxsanon {
  chain input {
    type filter hook input priority 0; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept
  }
  chain forward { type filter hook forward priority 0; policy drop; }
  chain output {
    type filter hook output priority 0; policy drop;
    oif "lo" accept
    meta skuid \$TORUID accept
    ip daddr 127.0.0.0/8 accept
    udp sport 68 udp dport 67 accept
    meta l4proto tcp reject with tcp reset
  }
}
NFT_EOF
# le connessioni gia' tracciate non devono piu' contare come "stabilite"
command -v conntrack >/dev/null 2>&1 && conntrack -F >/dev/null 2>&1 || true
: > "$STATE"
echo "ANON ON"
ROOT
}

_root_off() {
  cat <<ROOT
set -u
# ferma il nostro Tor anon
if [ -f "$PIDFILE" ]; then kill "\$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null || true; rm -f "$PIDFILE"; fi
# [t]or: il pattern non compare letterale in questo script (che gira con
# "sh -c" e il cui argv contiene tutto il testo): pkill -f non si suicida
pkill -f "[t]or -f $TORRC" 2>/dev/null || true
# rimuovi le tabelle del kill-switch e ripristina il firewall normale
command -v nft >/dev/null 2>&1 && nft flush ruleset 2>/dev/null || true
rm -f "$STATE" 2>/dev/null || true
echo "ANON OFF"
ROOT
}

do_on() {
  if is_on; then echo "on"; return 0; fi
  out="$(priv sh -c "$(_root_on)" 2>&1)" || { echo "$out" >&2; echo "off"; return 1; }
  echo "$out" | grep -q "ANON ON" || { echo "$out" >&2; echo "off"; return 1; }
  echo "on"
}

do_off() {
  priv sh -c "$(_root_off)" >/dev/null 2>&1 || true
  # ripristina il firewall standard NexusSec (a meno che sia stato disattivato)
  if [ ! -f /etc/nxs/firewall.disabled ] && command -v nxs-firewall >/dev/null 2>&1; then
    nxs-firewall boot >/dev/null 2>&1 || true
  fi
  echo "off"
}

# --- nuova identita': SIGNAL NEWNYM sul ControlPort (cookie leggibile da root)
do_newnym() {
  is_on || { echo "La modalita' anonima non e' attiva." >&2; return 1; }
  out="$(priv python3 - "$DATADIR/control_auth_cookie" "$CTRL_PORT" <<'PY' 2>&1
import socket, sys
cookie = open(sys.argv[1], "rb").read().hex()
s = socket.create_connection(("127.0.0.1", int(sys.argv[2])), 5)
s.sendall(("AUTHENTICATE %s\r\nSIGNAL NEWNYM\r\nQUIT\r\n" % cookie).encode())
data = b""
while True:
    b = s.recv(1024)
    if not b:
        break
    data += b
print(data.decode(errors="replace"))
PY
)" || true
  if [ "$(printf '%s\n' "$out" | grep -c '^250 OK')" -ge 2 ]; then
    echo "Nuova identita': i prossimi collegamenti useranno circuiti Tor nuovi."
  else
    echo "Nuova identita' non riuscita: $out" >&2; return 1
  fi
}

# --- verifica dell'anonimato (nessun dato inviato oltre la richiesta al check)
do_check() {
  ok=0; ko=0
  pass() { echo "  [OK]  $*"; ok=$((ok + 1)); }
  fail() { echo "  [NO]  $*"; ko=$((ko + 1)); }
  echo "Verifica della modalita' anonima"
  if is_on; then pass "modalita' anonima attiva (Tor trasparente)"
  else fail "modalita' anonima SPENTA: attivala prima della verifica"; echo; return 1; fi
  rules="$(priv nft list ruleset 2>/dev/null || true)"
  if printf '%s' "$rules" | grep -q "redirect to :$DNS_PORT"; then
    pass "DNS dirottato dentro Tor"
  else fail "DNS NON dirottato: possibile fuga DNS"; fi
  if printf '%s' "$rules" | grep -q "table inet nxsanon" && \
     printf '%s' "$rules" | grep -A3 "chain output" | grep -q "policy drop"; then
    pass "kill-switch attivo: se Tor cade non esce nulla in chiaro"
  else fail "kill-switch non trovato"; fi
  if printf '%s' "$rules" | grep -q "reject with tcp reset"; then
    pass "connessioni aperte prima dell'attivazione chiuse (non escono in chiaro)"
  else fail "le connessioni aperte prima potrebbero restare in chiaro"; fi
  # uscita reale: lo chiede a check.torproject.org passando (per forza) da Tor
  if have curl; then r="$(curl -s --max-time 30 https://check.torproject.org/api/ip 2>/dev/null || true)"
  else r="$(wget -qO- -T 30 https://check.torproject.org/api/ip 2>/dev/null || true)"; fi
  case "$r" in
    *'"IsTor":true'*) ip="$(printf '%s' "$r" | sed -n 's/.*"IP":"\([^"]*\)".*/\1/p')"
                      pass "il traffico esce da Tor (IP visibile: ${ip:-?})" ;;
    "") fail "nessuna risposta da check.torproject.org (Tor ancora in avvio? riprova)" ;;
    *) fail "il traffico NON risulta uscire da Tor: $r" ;;
  esac
  # risoluzione DNS funzionante (attraverso Tor)
  if nslookup check.torproject.org >/dev/null 2>&1; then pass "risoluzione dei nomi funzionante (via Tor)"
  else fail "risoluzione dei nomi non riuscita"; fi
  # IPv6: deve essere bloccato (Tor non lo instrada)
  if ip -6 route show default 2>/dev/null | grep -q .; then
    if ping -6 -c1 -W3 2606:4700:4700::1111 >/dev/null 2>&1; then
      fail "IPv6 raggiungibile fuori da Tor: FUGA"
    else pass "IPv6 bloccato"; fi
  else pass "IPv6 non in uso su questa rete"; fi
  echo
  echo "Risultato: $ok controlli superati, $ko problemi."
  [ "$ko" -eq 0 ]
}

do_boot() {
  case "${1:-status}" in
    on)  mkdir -p "$CONF"; : > "$BOOTFLAG"
         echo "La modalita' anonima partira' a ogni avvio (dopo lo sblocco dei dati)."
         [ -L "$CONF" ] || mountpoint -q /var/nxs-data 2>/dev/null || \
           echo "Attenzione: senza persistenza la scelta si perde al riavvio." ;;
    off) rm -f "$BOOTFLAG"; echo "La modalita' anonima non partira' piu' da sola." ;;
    status) [ -e "$BOOTFLAG" ] && echo on || echo off ;;
    *) echo "uso: nxs-anon boot on|off|status" >&2; return 2 ;;
  esac
}

do_bridges() {
  case "${1:-status}" in
    set) mkdir -p "$CONF"; umask 077
         cat > "$BRIDGES.new"
         mv "$BRIDGES.new" "$BRIDGES"
         n="$(_bridge_lines | grep -c . || true)"
         echo "Bridge salvati: $n."
         [ "$n" -gt 0 ] || echo "Nessuna riga valida (servono righe 'obfs4 ...' o 'Bridge obfs4 ...')."
         is_on && echo "Spegni e riaccendi la modalita' anonima per usarli." ;;
    clear) rm -f "$BRIDGES"; echo "Bridge rimossi." ;;
    status) n="$(_bridge_lines | grep -c . || true)"; echo "$n" ;;
    *) echo "uso: nxs-anon bridges set|clear|status" >&2; return 2 ;;
  esac
}

case "${1:-status}" in
  on)      do_on ;;
  off)     do_off ;;
  toggle)  if is_on; then do_off; else do_on; fi ;;
  status)  if is_on; then echo "on"; else echo "off"; fi ;;
  newnym)  do_newnym ;;
  check)   do_check ;;
  boot)    do_boot "${2:-status}" ;;
  bridges) do_bridges "${2:-status}" ;;
  *) echo "uso: nxs-anon {on|off|status|toggle|newnym|check|boot on|off|status|bridges set|clear|status}" >&2; exit 2 ;;
esac
