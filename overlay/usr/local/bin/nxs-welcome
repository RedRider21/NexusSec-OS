# nxs-welcome - finestra di benvenuto (primi passi, licenze, uso responsabile).
#
#   nxs-welcome           apre la finestra
#   nxs-welcome --auto    all'avvio: esce subito se l'utente l'ha disattivata
#                         ("Mostra all'avvio" tolta)
exec env PYTHONPATH=/usr/local/lib python3 -m nxs_welcome "$@" >>/tmp/nxs-welcome.log 2>&1
