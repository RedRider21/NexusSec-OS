"""nxs-registro - registro degli incarichi di NexusSec (vedi nxs_profiles.registro).

  nxs-registro [elenco [N]]      ultimi N lanci (default 20)
  nxs-registro verifica          integrita' della catena (righe modificate/tolte)
  nxs-registro verifica-file     i file prodotti corrispondono ancora alle impronte?
  nxs-registro esporta FILE.html rapporto HTML da allegare alla relazione
  nxs-registro salva-log         copia i log NexusSec (in RAM) nel registro
  nxs-registro percorso          dove sta il registro
"""
import sys
sys.path.insert(0, "/usr/local/lib")
from nxs_profiles import registro as R  # noqa: E402


def main(a):
    cmd = a[0] if a else "elenco"
    if cmd == "elenco":
        n = int(a[1]) if len(a) > 1 and a[1].isdigit() else 20
        fini = [v for v in R.voci() if v.get("evento") == "fine"][-n:]
        if not fini:
            print("Registro vuoto: %s" % R.FILE)
            return 0
        for v in fini:
            print("%s  %-14s %-8s %6ss  %s  [%s]" % (v.get("locale", ""), v.get("strumento", ""),
                  str(v.get("esito", "")), v.get("durata_s", ""), v.get("comando", ""),
                  v.get("rete", "")))
            for fp in v.get("file_prodotti") or []:
                print("      -> %s  %s" % (fp.get("file"), fp.get("sha256", "")[:16]))
        return 0
    if cmd == "verifica":
        ok, msg = R.verifica()
        print("\n".join(msg)); return 0 if ok else 1
    if cmd == "verifica-file":
        ok, msg = R.verifica_file()
        print("\n".join(msg)); return 0 if ok else 1
    if cmd == "esporta" and len(a) > 1:
        print("Rapporto: %s" % R.esporta_html(a[1])); return 0
    if cmd == "salva-log":
        d = R.salva_log()
        print("Log salvati in %s" % d if d else "Nessun log da salvare."); return 0
    if cmd == "percorso":
        print(R.FILE); return 0
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
