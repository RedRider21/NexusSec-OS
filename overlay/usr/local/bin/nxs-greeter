#!/usr/bin/env python3
# nxs-greeter - schermata di login grafica di NexusSec (in Python/GTK3).
#
# Autentica contro /etc/shadow tramite `nxs-authcheck` (Alpine non usa PAM di
# default). NON e' ancora agganciato al boot: qui e' l'INTERFACCIA + la verifica
# password, testabile nel desktop in esecuzione senza rischi:
#
#   nxs-greeter --windowed      finestra normale, per provare look e login
#   nxs-greeter                 a schermo intero (uso previsto dal boot, step 2)
#
# Codici d'uscita (per il futuro wrapper di boot che avviera' la sessione):
#   0 = autenticazione RIUSCITA (procedi con la sessione dell'utente)
#   1 = uscita senza login
# I pulsanti Riavvia/Spegni eseguono l'azione ed escono.
#
# La password NON passa mai da argv: viene inviata a nxs-authcheck via stdin.
import os
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib  # noqa: E402

# Tema NexusSec, se disponibile.
sys.path.insert(0, "/usr/local/lib")
try:
    from nxs_cc.common import apply_css
    apply_css()
except Exception:
    pass

WINDOWED = "--windowed" in sys.argv or bool(os.environ.get("NXS_GREETER_TEST"))
AUTH_USER_DEFAULT = os.environ.get("NXS_GREETER_USER", "nexus")


def authenticate(user, password):
    """True se la password e' corretta. Usa nxs-authcheck (root: diretto; utente:
    via doas, per poter leggere /etc/shadow). Password via stdin, mai in argv."""
    base = ["nxs-authcheck", user]
    cmd = base if os.geteuid() == 0 else (["doas"] + base)
    try:
        p = subprocess.run(cmd, input=(password + "\n").encode(),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return p.returncode == 0
    except Exception:
        return False


class Greeter(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("NexusSec OS")
        self.result = 1
        self.get_style_context().add_class("nxs-calbox")
        self.connect("destroy", Gtk.main_quit)
        if WINDOWED:
            self.set_default_size(420, 360)
            self.set_position(Gtk.WindowPosition.CENTER)
            self.connect("key-press-event", self._on_key)
        else:
            self.fullscreen()
            self.set_keep_above(True)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        outer.set_halign(Gtk.Align.CENTER)
        outer.set_valign(Gtk.Align.CENTER)
        outer.set_margin_top(40); outer.set_margin_bottom(40)
        outer.set_margin_start(40); outer.set_margin_end(40)
        self.add(outer)

        title = Gtk.Label()
        title.set_markup("<span size='xx-large'><b>NexusSec OS</b></span>")
        outer.pack_start(title, False, False, 0)
        sub = Gtk.Label()
        sub.set_markup("<small>Accedi per continuare</small>")
        outer.pack_start(sub, False, False, 0)

        form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        form.set_size_request(300, -1)
        outer.pack_start(form, False, False, 0)

        self.user = Gtk.Entry()
        self.user.set_placeholder_text("Utente")
        self.user.set_text(AUTH_USER_DEFAULT)
        form.pack_start(self.user, False, False, 0)

        self.pw = Gtk.Entry()
        self.pw.set_placeholder_text("Password")
        self.pw.set_visibility(False)
        self.pw.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.pw.connect("activate", self._on_login)   # Invio = accedi
        form.pack_start(self.pw, False, False, 0)

        self.err = Gtk.Label(); self.err.set_xalign(0.5)
        self.err.get_style_context().add_class("nxs-val")
        form.pack_start(self.err, False, False, 0)

        btn = Gtk.Button(label="Accedi")
        btn.get_style_context().add_class("nxs-menu-item")
        btn.connect("clicked", self._on_login)
        form.pack_start(btn, False, False, 0)

        power = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        power.set_halign(Gtk.Align.CENTER)
        b_r = Gtk.Button(label="Riavvia")
        b_r.get_style_context().add_class("nxs-menu-item")
        b_r.connect("clicked", lambda _w: self._power(["nxs-shutdown", "reboot"]))
        b_s = Gtk.Button(label="Spegni")
        b_s.get_style_context().add_class("nxs-menu-item")
        b_s.connect("clicked", lambda _w: self._power(["nxs-shutdown", "poweroff"]))
        power.pack_start(b_r, False, False, 0)
        power.pack_start(b_s, False, False, 0)
        outer.pack_start(power, False, False, 0)

        GLib.idle_add(self.pw.grab_focus)

    def _on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:      # solo in modalita' finestra (test)
            self.destroy()

    def _power(self, cmd):
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.destroy()

    def _on_login(self, _w):
        user = self.user.get_text().strip() or AUTH_USER_DEFAULT
        pw = self.pw.get_text()
        if authenticate(user, pw):
            self.result = 0
            if WINDOWED:
                print("AUTH-OK")
            self.destroy()
        else:
            self.err.set_markup("<span foreground='#ff5a8a'>Password errata</span>")
            self.pw.set_text("")
            self.pw.grab_focus()


def main():
    g = Greeter()
    g.show_all()
    Gtk.main()
    return g.result


if __name__ == "__main__":
    sys.exit(main())
