#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di NexusSec OS.
# nxs-greeter - schermata di login grafica di NexusSec (Python/GTK3).
#
# Aspetto sul modello di slick-greeter (Linux Mint): barra sottile in alto
# (host a sinistra; lingua tastiera, rete, batteria, data/ora e spegnimento a
# destra), sfondo del PROFILO ATTIVO nitido e appena scurito, riquadro compatto
# a sinistra con il nome dell'utente e il campo password con la freccia.
# Colori: accent del profilo (segue il cambio profilo come il resto del desktop).
#
# Autentica contro /etc/shadow tramite l'helper privilegiato:
#   - nxs-chkpwd (setuid root) se presente -> funziona anche su sistema
#     hardenizzato (doas con password);
#   - altrimenti nxs-authcheck via doas (live: doas nopass).
# La password NON passa mai da argv: va all'helper via STDIN.
#
#   nxs-greeter --windowed    finestra normale (test in-sessione)
#   nxs-greeter               a schermo intero (uso dal boot, dietro flag)
#
# Uscita: 0 = autenticazione riuscita · 1 = uscita senza login ·
#         3 = scelto Riavvia/Spegni (il sistema si sta fermando).
#
# Al rientro dopo il logout gira PRIMA del desktop, su X nudo e senza window
# manager (vedi ~/.xinitrc): la finestra si dimensiona da se' sullo schermo e
# prende da se' il fuoco della tastiera.
import glob
import math
import os
import pwd
import socket
import subprocess
import sys
import time

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib  # noqa: E402
import cairo  # noqa: E402

# Tema NexusSec (accent/CSS di base), se disponibile.
sys.path.insert(0, "/usr/local/lib")
try:
    from nxs_i18n import t as _t
except Exception:                       # noqa: BLE001
    def _t(chiave, **kw):               # ripiego: mostra la chiave
        return chiave
try:
    from nxs_cc.common import apply_css
    apply_css()
except Exception:
    pass

WINDOWED = "--windowed" in sys.argv or bool(os.environ.get("NXS_GREETER_TEST"))
AUTH_USER_DEFAULT = os.environ.get("NXS_GREETER_USER", "nexus")
CHKPWD = "/usr/bin/nxs-chkpwd"             # helper setuid (pacchetto apk)
AUTHCHECK = "/usr/local/bin/nxs-authcheck"  # fallback via doas

ACCENT = "#00e5ff"
OSCURA = 0.22          # velo scuro sopra lo sfondo (leggibilita' della barra)

# CSS con segnaposto @ACC@ (accent del profilo). Tutto sotto .nxs-gr per non
# toccare altro; priorita' USER per prevalere sul CSS comune di nxs_cc.
_CSS = """
.nxs-gr, .nxs-gr * { font-family: "Chakra Petch", "DejaVu Sans", sans-serif; }
.nxs-gr-bar { background-color: rgba(0,0,0,0.55); padding: 3px 12px; }
.nxs-gr-bar label { color: #e8f6fb; font-size: 10.5pt; }
.nxs-gr-bar image { color: #e8f6fb; }
.nxs-gr-box { background-color: rgba(5,12,20,0.66); border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.08); }
.nxs-gr-name { color: #ffffff; font-size: 15pt; font-weight: 600; }
.nxs-gr-msg { color: #ff5a8a; font-size: 10pt; }
.nxs-gr-hint { color: #ffb000; font-size: 10pt; }
.nxs-gr entry { min-height: 38px; background-image: none;
  background-color: rgba(8,16,26,0.85); color: #ffffff;
  border: 1px solid rgba(255,255,255,0.18); border-radius: 9px;
  padding: 0 12px; font-size: 12pt; box-shadow: none; caret-color: @ACC@; }
.nxs-gr entry:focus { border-color: @ACC@; }
.nxs-gr entry image { color: #7fa3b2; }
.nxs-gr entry selection { background-color: @ACC@; color: #041018; }
.nxs-gr button.nxs-gr-go { min-width: 38px; min-height: 38px; padding: 0;
  border-radius: 9px; border: none; box-shadow: none; background-image: none;
  background-color: @ACC@; color: #041018; }
.nxs-gr button.nxs-gr-go:hover { background-color: shade(@ACC@, 1.12); }
.nxs-gr button.nxs-gr-go image { color: #041018; }
.nxs-gr button.nxs-gr-flat { background: none; border: none; box-shadow: none;
  padding: 4px 6px; color: #cfe8f1; border-radius: 6px; }
.nxs-gr button.nxs-gr-flat:hover { background-color: rgba(255,255,255,0.10); }
.nxs-gr button.nxs-gr-flat image, .nxs-gr button.nxs-gr-flat label { color: #cfe8f1; }
.nxs-gr-pop { background-color: #0b1620; border: 1px solid #1a3a52; }
.nxs-gr-pop button { background: none; border: none; box-shadow: none;
  color: #e8f6fb; padding: 7px 14px; border-radius: 6px; }
.nxs-gr-pop button label { color: #e8f6fb; }
.nxs-gr-pop button:hover { background-color: rgba(255,255,255,0.08); }
"""


def _hex_rgb(h):
    h = h.lstrip("#")
    if len(h) != 6:
        return (0.0, 0.898, 1.0)
    return (int(h[0:2], 16) / 255.0, int(h[2:4], 16) / 255.0,
            int(h[4:6], 16) / 255.0)


def _accent():
    """Colore accent del TEMA CORRENTE (segue il profilo). Fallback: cyan."""
    try:
        from nxs_profiles import model
        a = model.accent()
        if a and a.startswith("#") and len(a) == 7:
            return a
    except Exception:
        pass
    return ACCENT


def _sfondo():
    """Percorso dello sfondo del profilo attivo (o di quello scelto a mano)."""
    try:
        from nxs_profiles import model
        p = str(model.wallpaper_path())
        if os.path.isfile(p):
            return p
    except Exception:
        pass
    return None


def _install_css(acc):
    try:
        prov = Gtk.CssProvider()
        prov.load_from_data(_CSS.replace("@ACC@", acc).encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    except Exception:
        pass


def authenticate(user, password):
    """True se la password e' corretta. Prova prima l'helper setuid nxs-chkpwd,
    poi nxs-authcheck via doas (live). Password via STDIN, mai in argv."""
    attempts = []
    if os.path.exists(CHKPWD):
        attempts.append([CHKPWD, user])
    if os.geteuid() == 0:
        attempts.append([AUTHCHECK, user])
    else:
        attempts.append(["doas", AUTHCHECK, user])
    for cmd in attempts:
        try:
            p = subprocess.run(cmd, input=(password + "\n").encode(),
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if p.returncode == 0:
                return True
        except Exception:
            continue
    return False


# --- dati di sistema per la barra e il riquadro ------------------------------
def utenti():
    """Utenti "umani" (uid 1000..65533 con una shell vera): (login, nome)."""
    out = []
    try:
        for p in pwd.getpwall():
            if 1000 <= p.pw_uid < 65534 and not p.pw_shell.endswith(
                    ("nologin", "false")):
                nome = (p.pw_gecos or "").split(",")[0].strip() or p.pw_name
                out.append((p.pw_name, nome))
    except Exception:
        pass
    if not any(u == AUTH_USER_DEFAULT for u, _ in out):
        out.insert(0, (AUTH_USER_DEFAULT, "NexusSec"))
    # l'utente predefinito per primo
    out.sort(key=lambda x: x[0] != AUTH_USER_DEFAULT)
    return out


def layout_tastiera():
    try:
        r = subprocess.run(["setxkbmap", "-query"], capture_output=True,
                           text=True, timeout=2)
        for riga in r.stdout.splitlines():
            if riga.startswith("layout:"):
                return riga.split(":", 1)[1].strip().split(",")[0].upper()
    except Exception:
        pass
    return ""


def icona_rete():
    wifi = cavo = False
    for d in glob.glob("/sys/class/net/*"):
        n = os.path.basename(d)
        if n == "lo":
            continue
        try:
            with open(os.path.join(d, "operstate")) as f:
                su = f.read().strip() == "up"
        except OSError:
            continue
        if su:
            if os.path.isdir(os.path.join(d, "wireless")):
                wifi = True
            else:
                cavo = True
    if cavo:
        return "network-wired-symbolic"
    if wifi:
        return "network-wireless-signal-good-symbolic"
    return "network-offline-symbolic"


def stato_batteria():
    """(icona, percentuale) o None se non c'e' batteria (desktop/VM)."""
    for d in glob.glob("/sys/class/power_supply/BAT*"):
        try:
            with open(os.path.join(d, "capacity")) as f:
                cap = int(f.read().strip())
            with open(os.path.join(d, "status")) as f:
                st = f.read().strip()
        except (OSError, ValueError):
            continue
        liv = ("full" if cap >= 90 else "good" if cap >= 50
               else "low" if cap >= 20 else "caution")
        car = st in ("Charging", "Full")
        if car and liv == "full":
            nome = "battery-full-charged-symbolic"
        else:
            nome = "battery-%s%s-symbolic" % (liv, "-charging" if car else "")
        return nome, cap
    return None


def _lista(chiave, riserva):
    v = _t(chiave).split(",")
    return v if len(v) == len(riserva) else riserva


def data_ora():
    t = time.localtime()
    giorni = _lista("gr.days", ["lun", "mar", "mer", "gio", "ven", "sab", "dom"])
    mesi = _lista("gr.months", ["gen", "feb", "mar", "apr", "mag", "giu", "lug",
                                "ago", "set", "ott", "nov", "dic"])
    return "%s %d %s   %s" % (giorni[t.tm_wday], t.tm_mday, mesi[t.tm_mon - 1],
                              time.strftime("%H:%M", t))


# --- piccoli elementi grafici ------------------------------------------------
def _icona(nome, px=16):
    i = Gtk.Image.new_from_icon_name(nome, Gtk.IconSize.MENU)
    i.set_pixel_size(px)
    return i


def _logo(px, rgb, spessore=2.0):
    """Esagono con la N (identita' NexusSec) nel colore del profilo."""
    a = Gtk.DrawingArea()
    a.set_size_request(px, px)

    def draw(w, cr):
        s = w.get_allocated_width()
        cx = cy = s / 2.0
        r = s / 2.0 - spessore
        cr.set_line_width(spessore)
        cr.set_source_rgb(*rgb)
        for i in range(6):
            ang = math.radians(60 * i - 90)
            (cr.line_to if i else cr.move_to)(cx + r * math.cos(ang),
                                              cy + r * math.sin(ang))
        cr.close_path()
        cr.stroke()
        cr.select_font_face("Chakra Petch", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(r * 1.0)
        e = cr.text_extents("N")
        cr.move_to(cx - e.width / 2 - e.x_bearing, cy - e.height / 2 - e.y_bearing)
        cr.show_text("N")
        return False
    a.connect("draw", draw)
    return a


def _flat(figlio, tip=None):
    b = Gtk.Button()
    b.add(figlio)
    b.set_relief(Gtk.ReliefStyle.NONE)
    b.set_can_focus(False)
    b.get_style_context().add_class("nxs-gr-flat")
    if tip:
        b.set_tooltip_text(tip)
    return b


def _popover(rel, voci):
    """Menu a comparsa sotto 'rel': voci = [(etichetta, callback)]."""
    pop = Gtk.Popover.new(rel)
    pop.get_style_context().add_class("nxs-gr-pop")
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    box.set_border_width(6)
    for testo, cb in voci:
        b = Gtk.Button(label=testo)
        b.get_child().set_xalign(0)
        b.connect("clicked", lambda _w, c=cb: (pop.popdown(), c()))
        box.pack_start(b, False, False, 0)
    box.show_all()
    pop.add(box)
    return pop


class Greeter(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("NexusSec OS")
        self.result = 1
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self._on_key)
        if WINDOWED:
            self.set_default_size(1280, 720)
            self.set_position(Gtk.WindowPosition.CENTER)
        else:
            # Senza window manager (rientro da .xinitrc) fullscreen() non ha
            # effetto: dimensioni e posizione dello schermo si impostano a mano.
            scr = Gdk.Screen.get_default()
            if scr is not None:
                self.set_default_size(scr.get_width(), scr.get_height())
            self.set_decorated(False)
            self.move(0, 0)
            self.fullscreen()
            self.set_keep_above(True)
            self.connect("map-event", self._prendi_fuoco)

        acc = _accent()
        self._acc = _hex_rgb(acc)
        _install_css(acc)
        self._utenti = utenti()
        self._utente = self._utenti[0][0]
        self._img = None                       # sfondo originale
        self._cache = None                     # sfondo gia' scalato (w, h, surf)
        p = _sfondo()
        if p:
            try:
                self._img = cairo.ImageSurface.create_from_png(p)
            except Exception:
                self._img = None

        ov = Gtk.Overlay()
        ov.get_style_context().add_class("nxs-gr")
        self.add(ov)
        bg = Gtk.DrawingArea()
        bg.connect("draw", self._draw_bg)
        ov.add(bg)
        ov.add_overlay(self._barra())
        ov.add_overlay(self._riquadro())

        GLib.timeout_add_seconds(5, self._aggiorna_barra)
        GLib.idle_add(self.pw.grab_focus)

    # --- barra in alto ---------------------------------------------------------
    def _barra(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        bar.get_style_context().add_class("nxs-gr-bar")
        bar.set_valign(Gtk.Align.START)
        sx = Gtk.Box(spacing=8)
        sx.pack_start(_logo(16, self._acc, 1.6), False, False, 0)
        host = Gtk.Label(label=socket.gethostname() or "nexussec")
        sx.pack_start(host, False, False, 0)
        bar.pack_start(sx, False, False, 0)

        # da destra verso sinistra: spegnimento, data/ora, batteria, rete, lingua
        self.b_power = _flat(_icona("system-shutdown-symbolic", 16), _t("gr.power"))
        pop = _popover(self.b_power, [
            (_t("session.reboot"), lambda: self._power(["nxs-shutdown", "reboot"])),
            (_t("session.poweroff"), lambda: self._power(["nxs-shutdown", "poweroff"])),
        ])
        self.b_power.connect("clicked", lambda _w: pop.popup())
        bar.pack_end(self.b_power, False, False, 0)
        self.l_ora = Gtk.Label()
        bar.pack_end(self.l_ora, False, False, 0)
        self.i_batt = _icona("battery-good-symbolic")
        self.l_batt = Gtk.Label()
        bb = Gtk.Box(spacing=4)
        bb.pack_start(self.i_batt, False, False, 0)
        bb.pack_start(self.l_batt, False, False, 0)
        self.box_batt = bb
        bar.pack_end(bb, False, False, 0)
        self.i_rete = _icona("network-offline-symbolic")
        bar.pack_end(self.i_rete, False, False, 0)
        self.l_kbd = Gtk.Label(label=layout_tastiera())
        bar.pack_end(self.l_kbd, False, False, 0)
        self._aggiorna_barra()
        return bar

    def _aggiorna_barra(self):
        self.l_ora.set_text(data_ora())
        self.i_rete.set_from_icon_name(icona_rete(), Gtk.IconSize.MENU)
        b = stato_batteria()
        if b:
            self.i_batt.set_from_icon_name(b[0], Gtk.IconSize.MENU)
            self.l_batt.set_text("%d%%" % b[1])
            self.box_batt.set_no_show_all(False)
            self.box_batt.show_all()
        else:
            self.box_batt.set_no_show_all(True)
            self.box_batt.hide()
        return True

    # --- riquadro di accesso -------------------------------------------------------
    def _riquadro(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("nxs-gr-box")
        box.set_size_request(400, -1)
        box.set_halign(Gtk.Align.START)
        box.set_valign(Gtk.Align.CENTER)
        # posizione come slick-greeter: ~8% da sinistra, poco sotto il centro
        scr = Gdk.Screen.get_default()
        larg = scr.get_width() if scr else 1600
        box.set_margin_start(max(40, int(larg * 0.085)))
        box.set_margin_top(60)

        testa = Gtk.Box(spacing=8)
        testa.set_margin_top(12); testa.set_margin_start(16); testa.set_margin_end(8)
        self.l_nome = Gtk.Label()
        self.l_nome.set_xalign(0)
        self.l_nome.get_style_context().add_class("nxs-gr-name")
        testa.pack_start(self.l_nome, True, True, 0)
        # cambio utente: solo se ce n'e' piu' d'uno (o per digitarne un altro)
        self.b_utenti = _flat(_icona("system-users-symbolic", 16), _t("gr.switch_user"))
        voci = [(nome if nome == login else "%s  (%s)" % (nome, login),
                 lambda l=login: self._scegli(l)) for login, nome in self._utenti]
        voci.append((_t("gr.other_user"), self._altro))
        pop = _popover(self.b_utenti, voci)
        self.b_utenti.connect("clicked", lambda _w: pop.popup())
        testa.pack_end(self.b_utenti, False, False, 0)
        box.pack_start(testa, False, False, 0)

        corpo = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        corpo.set_margin_top(8); corpo.set_margin_bottom(16)
        corpo.set_margin_start(16); corpo.set_margin_end(16)
        # campo utente: nascosto, compare solo con "Altro utente..."
        self.user = Gtk.Entry()
        self.user.set_placeholder_text(_t("v.user"))
        self.user.set_icon_from_icon_name(Gtk.EntryIconPosition.PRIMARY,
                                          "avatar-default-symbolic")
        self.user.set_no_show_all(True)
        self.user.connect("activate", lambda _w: self.pw.grab_focus())
        corpo.pack_start(self.user, False, False, 0)

        riga = Gtk.Box(spacing=8)
        self.pw = Gtk.Entry()
        self.pw.set_placeholder_text(_t("v.password"))
        self.pw.set_visibility(False)
        self.pw.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.pw.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY,
                                        "view-reveal-symbolic")
        self.pw.connect("icon-press", self._toggle_pw)
        self.pw.connect("activate", self._on_login)
        riga.pack_start(self.pw, True, True, 0)
        vai = Gtk.Button()
        vai.add(_icona("go-next-symbolic", 18))
        vai.get_style_context().add_class("nxs-gr-go")
        vai.set_tooltip_text(_t("gr.login"))
        vai.connect("clicked", self._on_login)
        riga.pack_start(vai, False, False, 0)
        corpo.pack_start(riga, False, False, 0)

        self.msg = Gtk.Label()
        self.msg.set_xalign(0)
        self.msg.set_no_show_all(True)
        corpo.pack_start(self.msg, False, False, 0)
        box.pack_start(corpo, False, False, 0)

        self._scegli(self._utente, focus=False)
        return box

    def _nome_di(self, login):
        for l, n in self._utenti:
            if l == login:
                return n
        return login

    def _scegli(self, login, focus=True):
        self._utente = login
        self.l_nome.set_text(self._nome_di(login))
        self.user.hide()
        self._messaggio("")
        self.pw.set_text("")
        if focus:
            self.pw.grab_focus()

    def _altro(self):
        self._utente = None
        self.l_nome.set_text(_t("gr.other_user").rstrip("…."))
        self.user.set_text("")
        self.user.show()
        self._messaggio("")
        self.user.grab_focus()

    def _messaggio(self, testo, classe="nxs-gr-msg"):
        ctx = self.msg.get_style_context()
        for c in ("nxs-gr-msg", "nxs-gr-hint"):
            ctx.remove_class(c)
        ctx.add_class(classe)
        self.msg.set_text(testo)
        self.msg.set_visible(bool(testo))

    # --- sfondo ---------------------------------------------------------------
    def _draw_bg(self, area, cr):
        """Sfondo del profilo a tutto schermo ("copri", senza deformarlo) con un
        velo scuro leggero; la versione scalata si tiene in cache."""
        w = area.get_allocated_width()
        h = area.get_allocated_height()
        if self._img is None:
            cr.set_source_rgb(0.020, 0.039, 0.078)          # #050a14
            cr.paint()
            r, g, b = self._acc
            grad = cairo.RadialGradient(w * 0.55, h * 0.45, 0,
                                        w * 0.55, h * 0.45, max(w, h) * 0.6)
            grad.add_color_stop_rgba(0, r, g, b, 0.12)
            grad.add_color_stop_rgba(1, r, g, b, 0.0)
            cr.set_source(grad)
            cr.paint()
            return False
        if not self._cache or self._cache[:2] != (w, h):
            surf = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
            c = cairo.Context(surf)
            iw, ih = self._img.get_width(), self._img.get_height()
            sc = max(w / iw, h / ih)
            c.translate((w - iw * sc) / 2.0, (h - ih * sc) / 2.0)
            c.scale(sc, sc)
            c.set_source_surface(self._img, 0, 0)
            c.get_source().set_filter(cairo.FILTER_GOOD)
            c.paint()
            c.identity_matrix()
            c.set_source_rgba(0.01, 0.02, 0.04, OSCURA)
            c.paint()
            self._cache = (w, h, surf)
        cr.set_source_surface(self._cache[2], 0, 0)
        cr.paint()
        return False

    # --- azioni -----------------------------------------------------------------
    def _toggle_pw(self, entry, _pos, _ev):
        vis = not entry.get_visibility()
        entry.set_visibility(vis)
        entry.set_icon_from_icon_name(
            Gtk.EntryIconPosition.SECONDARY,
            "view-conceal-symbolic" if vis else "view-reveal-symbolic")

    def _on_key(self, _w, ev):
        if WINDOWED and ev.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        # avviso Bloc Maiusc (solo se non c'e' gia' un errore da mostrare)
        GLib.idle_add(self._caps)
        return False

    def _caps(self):
        try:
            caps = Gdk.Keymap.get_for_display(Gdk.Display.get_default()) \
                .get_caps_lock_state()
        except Exception:
            return False
        ctx = self.msg.get_style_context()
        if caps:
            if not self.msg.get_visible() or ctx.has_class("nxs-gr-hint"):
                self._messaggio(_t("gr.caps"), "nxs-gr-hint")
        elif ctx.has_class("nxs-gr-hint"):
            self._messaggio("")
        return False

    def _prendi_fuoco(self, *_a):
        # senza window manager nessuno assegna il fuoco: lo si chiede a X
        try:
            self.get_window().focus(Gdk.CURRENT_TIME)
        except Exception:
            pass
        self.pw.grab_focus()
        return False

    def _power(self, cmd):
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.result = 3
        self.destroy()

    def _on_login(self, _w):
        user = self._utente or self.user.get_text().strip() or AUTH_USER_DEFAULT
        pw = self.pw.get_text()
        if authenticate(user, pw):
            self.result = 0
            if WINDOWED:
                print("AUTH-OK")
            self.destroy()
        else:
            self._messaggio(_t("gr.wrong"))
            self.pw.set_text("")
            self.pw.grab_focus()


def main():
    # Serve una sessione grafica: se lanciato dalla console testuale (es. dopo il
    # logout, quando X non e' attivo) niente traceback GTK, ma un messaggio chiaro.
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        sys.stderr.write(
            "nxs-greeter: nessuna sessione grafica (X non attivo).\n"
            "Avvialo da un TERMINALE DENTRO il desktop, non dalla console dopo "
            "il logout. Per il login grafico al boot: doas nxs-harden greeter on.\n")
        return 2
    g = Greeter()
    g.show_all()
    Gtk.main()
    return g.result


if __name__ == "__main__":
    sys.exit(main())
