#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di NexusSec OS.
# nxs-greeter - schermata di login grafica di NexusSec (Python/GTK3).
#
# Autentica contro /etc/shadow tramite l'helper privilegiato:
#   - nxs-chkpwd (setuid root) se presente -> funziona anche su sistema
#     hardenizzato (doas con password);
#   - altrimenti nxs-authcheck via doas (live: doas nopass).
# La password NON passa mai da argv: va all'helper via STDIN.
#
#   nxs-greeter --windowed    finestra normale (test in-sessione)
#   nxs-greeter               a schermo intero (uso dal boot, dietro flag)
#
# Uscita: 0 = autenticazione riuscita · 1 = uscita senza login.
import math
import os
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib  # noqa: E402
import cairo  # noqa: E402

# Tema NexusSec (accent/CSS di base), se disponibile.
sys.path.insert(0, "/usr/local/lib")
try:
    from nxs_cc.common import apply_css
    apply_css()
except Exception:
    pass

WINDOWED = "--windowed" in sys.argv or bool(os.environ.get("NXS_GREETER_TEST"))
AUTH_USER_DEFAULT = os.environ.get("NXS_GREETER_USER", "nexus")
CHKPWD = "/usr/bin/nxs-chkpwd"             # helper setuid (pacchetto apk)
AUTHCHECK = "/usr/local/bin/nxs-authcheck"  # fallback via doas

ACCENT = "#00e5ff"

_CSS = b"""
window { background-color: #050a14; }
.nxs-gr-card { background-color: rgba(10,26,38,0.94);
  border: 1px solid #1a3a52; border-radius: 16px; }
.nxs-gr-title { color: #eaffff; }
.nxs-gr-sub { color: #5a8a9a; }
.nxs-gr-err { color: #ff5a8a; }
.nxs-gr entry { min-height: 34px; background-color: #08131d; color: #c8f5ff;
  border: 1px solid #1a3a52; border-radius: 9px; padding: 4px 10px; }
.nxs-gr entry:focus { border-color: #00e5ff; }
.nxs-gr-login { background-color: #00334a; color: #00e5ff;
  border: 1px solid #17475f; border-radius: 10px; padding: 8px 0; }
.nxs-gr-login:hover { background-color: #0a4a63; }
.nxs-gr-pw { background: none; border: none; color: #5a8a9a; padding: 6px 10px; }
.nxs-gr-pw:hover { color: #00e5ff; }
"""


def _hex_rgb(h):
    h = h.lstrip("#")
    if len(h) != 6:
        return (0.0, 0.898, 1.0)
    return (int(h[0:2], 16) / 255.0, int(h[2:4], 16) / 255.0,
            int(h[4:6], 16) / 255.0)


def _accent():
    """Colore accent del TEMA CORRENTE (segue il profilo). Fallback: cyan."""
    try:
        from nxs_profiles import model
        a = model.accent()
        if a and a.startswith("#") and len(a) == 7:
            return a
    except Exception:
        pass
    return ACCENT


def _install_css():
    try:
        prov = Gtk.CssProvider()
        prov.load_from_data(_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    except Exception:
        pass


def authenticate(user, password):
    """True se la password e' corretta. Prova prima l'helper setuid nxs-chkpwd,
    poi nxs-authcheck via doas (live). Password via STDIN, mai in argv."""
    attempts = []
    if os.path.exists(CHKPWD):
        attempts.append([CHKPWD, user])
    if os.geteuid() == 0:
        attempts.append([AUTHCHECK, user])
    else:
        attempts.append(["doas", AUTHCHECK, user])
    for cmd in attempts:
        try:
            p = subprocess.run(cmd, input=(password + "\n").encode(),
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if p.returncode == 0:
                return True
        except Exception:
            continue
    return False


def _draw_logo(_area, cr):
    # Esagono cyan con "N" al centro (identita' NexusSec).
    w = _area.get_allocated_width()
    h = _area.get_allocated_height()
    cx, cy = w / 2.0, h / 2.0
    r = min(w, h) / 2.0 - 6
    cr.set_line_width(5)
    cr.set_source_rgb(0.0, 0.898, 1.0)          # #00e5ff
    for i in range(6):
        ang = math.pi / 180 * (60 * i - 90)
        x = cx + r * math.cos(ang)
        y = cy + r * math.sin(ang)
        cr.line_to(x, y) if i else cr.move_to(x, y)
    cr.close_path()
    cr.stroke()
    cr.select_font_face("sans-serif", cairo.FONT_SLANT_NORMAL,
                        cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(r * 1.05)
    ext = cr.text_extents("N")
    cr.move_to(cx - ext.width / 2 - ext.x_bearing,
               cy - ext.height / 2 - ext.y_bearing)
    cr.show_text("N")
    return False


class Greeter(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("NexusSec OS")
        self.result = 1
        self.connect("destroy", Gtk.main_quit)
        if WINDOWED:
            self.set_default_size(460, 480)
            self.set_position(Gtk.WindowPosition.CENTER)
            self.connect("key-press-event", self._on_key)
        else:
            self.fullscreen()
            self.set_keep_above(True)

        # Sfondo (wallpaper) disegnato con Cairo dietro la card, via Overlay:
        # affidabile a schermo intero (il background-image CSS su window in GTK3
        # spesso non dipinge).
        self._acc = _hex_rgb(_accent())          # colore del tema corrente
        overlay = Gtk.Overlay()
        self.add(overlay)
        bgarea = Gtk.DrawingArea()
        bgarea.connect("draw", self._draw_bg)
        overlay.add(bgarea)                       # sfondo honeycomb a tutto schermo
        # card di login CENTRATA (scelta utente), sopra lo sfondo pulito honeycomb.
        center = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        center.set_halign(Gtk.Align.CENTER)
        center.set_valign(Gtk.Align.CENTER)
        overlay.add_overlay(center)               # card sopra lo sfondo

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card.get_style_context().add_class("nxs-gr-card")
        card.get_style_context().add_class("nxs-gr")
        card.set_size_request(360, -1)
        card.set_margin_top(28); card.set_margin_bottom(28)
        card.set_margin_start(34); card.set_margin_end(34)
        center.pack_start(card, False, False, 0)

        logo = Gtk.DrawingArea()
        logo.set_size_request(96, 104)
        logo.set_halign(Gtk.Align.CENTER)
        logo.connect("draw", _draw_logo)
        card.pack_start(logo, False, False, 0)

        title = Gtk.Label()
        title.get_style_context().add_class("nxs-gr-title")
        title.set_markup("<span size='xx-large'><b>NexusSec OS</b></span>")
        card.pack_start(title, False, False, 0)
        sub = Gtk.Label()
        sub.get_style_context().add_class("nxs-gr-sub")
        sub.set_markup("<small>Accedi per continuare</small>")
        card.pack_start(sub, False, False, 0)

        self.user = Gtk.Entry()
        self.user.set_placeholder_text("Utente")
        self.user.set_text(AUTH_USER_DEFAULT)
        card.pack_start(self.user, False, False, 0)

        self.pw = Gtk.Entry()
        self.pw.set_placeholder_text("Password")
        self.pw.set_visibility(False)
        self.pw.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.pw.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY,
                                        "view-reveal-symbolic")
        self.pw.connect("icon-press", self._toggle_pw)
        self.pw.connect("activate", self._on_login)
        card.pack_start(self.pw, False, False, 0)

        self.err = Gtk.Label(); self.err.set_xalign(0.5)
        self.err.get_style_context().add_class("nxs-gr-err")
        card.pack_start(self.err, False, False, 0)

        btn = Gtk.Button(label="Accedi")
        btn.get_style_context().add_class("nxs-gr-login")
        btn.connect("clicked", self._on_login)
        card.pack_start(btn, False, False, 0)

        power = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        power.set_halign(Gtk.Align.CENTER)
        power.set_margin_top(6)
        for icon, cmd in (("system-reboot-symbolic", ["nxs-shutdown", "reboot"]),
                          ("system-shutdown-symbolic", ["nxs-shutdown", "poweroff"])):
            b = Gtk.Button()
            b.get_style_context().add_class("nxs-gr-pw")
            b.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR))
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.connect("clicked", lambda _w, c=cmd: self._power(c))
            power.pack_start(b, False, False, 0)
        card.pack_start(power, False, False, 0)

        GLib.idle_add(self.pw.grab_focus)

    @staticmethod
    def _hexagon(cr, cx, cy, R):
        for i in range(6):
            ang = math.pi / 3.0 * i               # flat-top
            px = cx + R * math.cos(ang)
            py = cy + R * math.sin(ang)
            (cr.line_to if i else cr.move_to)(px, py)
        cr.close_path()

    def _draw_bg(self, area, cr):
        """Sfondo PULITO: fondo scuro + glow morbido + honeycomb ("vespaio"),
        nel colore accent del tema corrente. Niente logo/scritte."""
        w = area.get_allocated_width()
        h = area.get_allocated_height()
        r, g, b = self._acc
        # fondo scuro
        cr.set_source_rgb(0.020, 0.039, 0.078)        # #050a14
        cr.paint()
        # glow morbido (accent) in alto-centro
        cx, cy = w / 2.0, h * 0.40
        rad = max(w, h) * 0.62
        grad = cairo.RadialGradient(cx, cy, 0, cx, cy, rad)
        grad.add_color_stop_rgba(0, r, g, b, 0.10)
        grad.add_color_stop_rgba(1, r, g, b, 0.0)
        cr.set_source(grad)
        cr.paint()
        # honeycomb (vespaio) tenue
        R = 46.0
        dx = 1.5 * R
        dy = math.sqrt(3.0) * R
        cr.set_line_width(1.2)
        cr.set_source_rgba(r, g, b, 0.12)
        col = 0
        x = -R
        while x < w + R:
            yoff = (dy / 2.0) if (col % 2) else 0.0
            y = -R + yoff
            while y < h + R:
                self._hexagon(cr, x, y, R)
                y += dy
            x += dx
            col += 1
        cr.stroke()
        return False

    def _toggle_pw(self, entry, _pos, _ev):
        vis = not entry.get_visibility()
        entry.set_visibility(vis)
        entry.set_icon_from_icon_name(
            Gtk.EntryIconPosition.SECONDARY,
            "view-conceal-symbolic" if vis else "view-reveal-symbolic")

    def _on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.destroy()

    def _power(self, cmd):
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.destroy()

    def _on_login(self, _w):
        user = self.user.get_text().strip() or AUTH_USER_DEFAULT
        pw = self.pw.get_text()
        if authenticate(user, pw):
            self.result = 0
            if WINDOWED:
                print("AUTH-OK")
            self.destroy()
        else:
            self.err.set_text("Password errata")
            self.pw.set_text("")
            self.pw.grab_focus()


def main():
    # Serve una sessione grafica: se lanciato dalla console testuale (es. dopo il
    # logout, quando X non e' attivo) niente traceback GTK, ma un messaggio chiaro.
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        sys.stderr.write(
            "nxs-greeter: nessuna sessione grafica (X non attivo).\n"
            "Avvialo da un TERMINALE DENTRO il desktop, non dalla console dopo "
            "il logout. Per il login grafico al boot: doas nxs-harden greeter on.\n")
        return 2
    _install_css()
    g = Greeter()
    g.show_all()
    Gtk.main()
    return g.result


if __name__ == "__main__":
    sys.exit(main())
