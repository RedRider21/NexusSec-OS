<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu root di Openbox: compare col TASTO DESTRO sul DESKTOP (pcmanfm ha
     show_wm_menu=1, quindi inoltra il clic al window manager). Raccoglie le
     azioni piu' frequenti cosi' non serve aprire il menu dal pannello.
     Icone: SVG gia' tinti in /usr/local/share/nexussec/menu-icons (Openbox non
     ricolora le simboliche; vedi build/make-menu-icons.py). Lingue: questo e'
     il menu italiano, le altre le genera build/make-openbox-menus.py. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="nxs-tools" label="Herramientas" icon="/usr/local/share/nexussec/menu-icons/tools.svg">
    <item label="Editor de texto" icon="/usr/local/share/nexussec/menu-icons/editor.svg"><action name="Execute"><command>nxs-editor</command></action></item>
    <item label="Grabadora de voz" icon="/usr/local/share/nexussec/menu-icons/recorder.svg"><action name="Execute"><command>nxs-recorder</command></action></item>
    <item label="Imágenes" icon="/usr/local/share/nexussec/menu-icons/images.svg"><action name="Execute"><command>nxs-viewer</command></action></item>
    <item label="Limpiar metadatos (MAT2)" icon="/usr/local/share/nexussec/menu-icons/metadata.svg"><action name="Execute"><command>nxs-metadata gui</command></action></item>
    <item label="Portapapeles (historial)" icon="/usr/local/share/nexussec/menu-icons/clipboard.svg"><action name="Execute"><command>nxs-clipboard menu</command></action></item>
    <item label="Filtro de luz azul (on/off)" icon="/usr/local/share/nexussec/menu-icons/nightlight.svg"><action name="Execute"><command>nxs-nightlight toggle</command></action></item>
    <item label="Atajos de teclado" icon="/usr/local/share/nexussec/menu-icons/keyboard.svg"><action name="Execute"><command>nxs-control-center hotkey</command></action></item>
    <item label="Discos" icon="/usr/local/share/nexussec/menu-icons/disks.svg"><action name="Execute"><command>nxs-disks</command></action></item>
    <item label="Casos forenses" icon="/usr/local/share/nexussec/menu-icons/cases.svg"><action name="Execute"><command>nxs-case</command></action></item>
    <item label="Procedimientos guiados (Wizard)" icon="/usr/local/share/nexussec/menu-icons/wizard.svg"><action name="Execute"><command>nxs-wizard</command></action></item>
    <item label="Centro de control" icon="/usr/local/share/nexussec/menu-icons/control-center.svg"><action name="Execute"><command>nxs-control-center</command></action></item>
  </menu>

  <menu id="nxs-security" label="Seguridad" icon="/usr/local/share/nexussec/menu-icons/security.svg">
    <item label="Bloquear pantalla" icon="/usr/local/share/nexussec/menu-icons/lock.svg"><action name="Execute"><command>nxs-screensaver</command></action></item>
    <item label="Captura de pantalla (completa)" icon="/usr/local/share/nexussec/menu-icons/screenshot.svg"><action name="Execute"><command>nxs-screenshot full 1</command></action></item>
    <item label="Captura de pantalla (área)" icon="/usr/local/share/nexussec/menu-icons/screenshot.svg"><action name="Execute"><command>nxs-screenshot area 0</command></action></item>
    <separator/>
    <item label="Anónimo (todo por Tor): ACTIVAR" icon="/usr/local/share/nexussec/menu-icons/anon.svg"><action name="Execute"><command>nxs-anon on</command></action></item>
    <item label="Anónimo (todo por Tor): DESACTIVAR" icon="/usr/local/share/nexussec/menu-icons/anon.svg"><action name="Execute"><command>nxs-anon off</command></action></item>
    <separator/>
    <item label="Cortafuegos: ACTIVAR" icon="/usr/local/share/nexussec/menu-icons/firewall.svg"><action name="Execute"><command>nxs-firewall on</command></action></item>
    <item label="Cortafuegos: DESACTIVAR" icon="/usr/local/share/nexussec/menu-icons/firewall.svg"><action name="Execute"><command>nxs-firewall off</command></action></item>
    <separator/>
    <item label="MAC aleatoria ahora" icon="/usr/local/share/nexussec/menu-icons/mac.svg"><action name="Execute"><command>nxs-macspoof now</command></action></item>
    <separator/>
    <item label="PÁNICO: borrar y apagar" icon="/usr/local/share/nexussec/menu-icons/panic.svg"><action name="Execute"><command>nxs-panic wipe</command></action></item>
  </menu>

  <menu id="root-menu" label="NexusSec">
    <!-- intestazione: Openbox la disegna con lo stile "menu.title" del tema
         (font MenuHeader = Chakra Petch, colore d'accento) -->
    <separator label="NexusSec"/>
    <item label="Perfil operativo" icon="/usr/local/share/nexussec/menu-icons/profile.svg"><action name="Execute"><command>nxs-profile</command></action></item>
    <item label="Cambiar fondo" icon="/usr/local/share/nexussec/menu-icons/wallpaper.svg"><action name="Execute"><command>nxs-control-center sfondo</command></action></item>
    <separator/>
    <item label="Terminal" icon="/usr/local/share/nexussec/menu-icons/terminal.svg"><action name="Execute"><command>nxs-terminal</command></action></item>
    <item label="NexusSec Browser" icon="/usr/local/share/nexussec/menu-icons/browser.svg"><action name="Execute"><command>nxs-browser</command></action></item>
    <item label="Gestor de archivos" icon="/usr/local/share/nexussec/menu-icons/files.svg"><action name="Execute"><command>pcmanfm</command></action></item>
    <item label="HORUS (OSINT global)" icon="/usr/local/share/nexussec/menu-icons/horus.svg"><action name="Execute"><command>nxs-horus</command></action></item>
    <separator/>
    <menu id="nxs-tools"/>
    <menu id="nxs-security"/>
    <separator/>
    <item label="Bienvenida y licencias" icon="/usr/local/share/nexussec/menu-icons/welcome.svg"><action name="Execute"><command>nxs-welcome</command></action></item>
    <item label="Reiniciar Openbox" icon="/usr/local/share/nexussec/menu-icons/reload.svg"><action name="Reconfigure"/></item>
    <item label="Salir / Apagar…" icon="/usr/local/share/nexussec/menu-icons/shutdown.svg"><action name="Execute"><command>nxs-session</command></action></item>
  </menu>

</openbox_menu>
