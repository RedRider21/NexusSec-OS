<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu root di Openbox: compare col TASTO DESTRO sul DESKTOP (pcmanfm ha
     show_wm_menu=1, quindi inoltra il clic al window manager). Raccoglie le
     azioni piu' frequenti cosi' non serve aprire il menu dal pannello.
     Icone: SVG gia' tinti in /usr/local/share/nexussec/menu-icons (Openbox non
     ricolora le simboliche; vedi build/make-menu-icons.py). Lingue: questo e'
     il menu italiano, le altre le genera build/make-openbox-menus.py. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="nxs-tools" label="Outils" icon="/usr/local/share/nexussec/menu-icons/tools.svg">
    <item label="Éditeur de texte" icon="/usr/local/share/nexussec/menu-icons/editor.svg"><action name="Execute"><command>nxs-editor</command></action></item>
    <item label="Enregistreur vocal" icon="/usr/local/share/nexussec/menu-icons/recorder.svg"><action name="Execute"><command>nxs-recorder</command></action></item>
    <item label="Images" icon="/usr/local/share/nexussec/menu-icons/images.svg"><action name="Execute"><command>nxs-viewer</command></action></item>
    <item label="Nettoyer les métadonnées (MAT2)" icon="/usr/local/share/nexussec/menu-icons/metadata.svg"><action name="Execute"><command>nxs-metadata gui</command></action></item>
    <item label="Presse-papiers (historique)" icon="/usr/local/share/nexussec/menu-icons/clipboard.svg"><action name="Execute"><command>nxs-clipboard menu</command></action></item>
    <item label="Filtre lumière bleue (on/off)" icon="/usr/local/share/nexussec/menu-icons/nightlight.svg"><action name="Execute"><command>nxs-nightlight toggle</command></action></item>
    <item label="Raccourcis clavier" icon="/usr/local/share/nexussec/menu-icons/keyboard.svg"><action name="Execute"><command>nxs-control-center hotkey</command></action></item>
    <item label="Disques" icon="/usr/local/share/nexussec/menu-icons/disks.svg"><action name="Execute"><command>nxs-disks</command></action></item>
    <item label="Affaires forensiques" icon="/usr/local/share/nexussec/menu-icons/cases.svg"><action name="Execute"><command>nxs-case</command></action></item>
    <item label="Procédures guidées (Wizard)" icon="/usr/local/share/nexussec/menu-icons/wizard.svg"><action name="Execute"><command>nxs-wizard</command></action></item>
    <item label="Centre de contrôle" icon="/usr/local/share/nexussec/menu-icons/control-center.svg"><action name="Execute"><command>nxs-control-center</command></action></item>
  </menu>

  <menu id="nxs-security" label="Sécurité" icon="/usr/local/share/nexussec/menu-icons/security.svg">
    <item label="Verrouiller l'écran" icon="/usr/local/share/nexussec/menu-icons/lock.svg"><action name="Execute"><command>nxs-screensaver</command></action></item>
    <item label="Capture d'écran (entière)" icon="/usr/local/share/nexussec/menu-icons/screenshot.svg"><action name="Execute"><command>nxs-screenshot full 1</command></action></item>
    <item label="Capture d'écran (zone)" icon="/usr/local/share/nexussec/menu-icons/screenshot.svg"><action name="Execute"><command>nxs-screenshot area 0</command></action></item>
    <separator/>
    <item label="Anonyme (tout via Tor) : ACTIVER" icon="/usr/local/share/nexussec/menu-icons/anon.svg"><action name="Execute"><command>nxs-anon on</command></action></item>
    <item label="Anonyme (tout via Tor) : DÉSACTIVER" icon="/usr/local/share/nexussec/menu-icons/anon.svg"><action name="Execute"><command>nxs-anon off</command></action></item>
    <separator/>
    <item label="Pare-feu : ACTIVER" icon="/usr/local/share/nexussec/menu-icons/firewall.svg"><action name="Execute"><command>nxs-firewall on</command></action></item>
    <item label="Pare-feu : DÉSACTIVER" icon="/usr/local/share/nexussec/menu-icons/firewall.svg"><action name="Execute"><command>nxs-firewall off</command></action></item>
    <separator/>
    <item label="MAC aléatoire maintenant" icon="/usr/local/share/nexussec/menu-icons/mac.svg"><action name="Execute"><command>nxs-macspoof now</command></action></item>
    <separator/>
    <item label="PANIQUE : effacer et éteindre" icon="/usr/local/share/nexussec/menu-icons/panic.svg"><action name="Execute"><command>nxs-panic wipe</command></action></item>
  </menu>

  <menu id="root-menu" label="NexusSec">
    <!-- intestazione: Openbox la disegna con lo stile "menu.title" del tema
         (font MenuHeader = Chakra Petch, colore d'accento) -->
    <separator label="NexusSec"/>
    <item label="Profil opérationnel" icon="/usr/local/share/nexussec/menu-icons/profile.svg"><action name="Execute"><command>nxs-profile</command></action></item>
    <item label="Changer le fond d'écran" icon="/usr/local/share/nexussec/menu-icons/wallpaper.svg"><action name="Execute"><command>nxs-control-center sfondo</command></action></item>
    <separator/>
    <item label="Terminal" icon="/usr/local/share/nexussec/menu-icons/terminal.svg"><action name="Execute"><command>nxs-terminal</command></action></item>
    <item label="NexusSec Browser" icon="/usr/local/share/nexussec/menu-icons/browser.svg"><action name="Execute"><command>nxs-browser</command></action></item>
    <item label="Gestionnaire de fichiers" icon="/usr/local/share/nexussec/menu-icons/files.svg"><action name="Execute"><command>pcmanfm</command></action></item>
    <item label="HORUS (OSINT mondial)" icon="/usr/local/share/nexussec/menu-icons/horus.svg"><action name="Execute"><command>nxs-horus</command></action></item>
    <separator/>
    <menu id="nxs-tools"/>
    <menu id="nxs-security"/>
    <separator/>
    <item label="Bienvenue et licences" icon="/usr/local/share/nexussec/menu-icons/welcome.svg"><action name="Execute"><command>nxs-welcome</command></action></item>
    <item label="Redémarrer Openbox" icon="/usr/local/share/nexussec/menu-icons/reload.svg"><action name="Reconfigure"/></item>
    <item label="Déconnexion / Éteindre…" icon="/usr/local/share/nexussec/menu-icons/shutdown.svg"><action name="Execute"><command>nxs-session</command></action></item>
  </menu>

</openbox_menu>
