[Icon Theme]
Name=NexusSec-Core
Comment=Icone NexusSec - eredita nuoveXT2 (lxde) e Adwaita per copertura completa
Inherits=nuoveXT2,Adwaita,gnome,hicolor
Directories=apps/16,apps/22,apps/24,apps/32,apps/48,apps/64,apps/128,apps/256

# Meta-tema: eredita nuoveXT2/Adwaita per la copertura generale e ospita le
# poche icone proprie di NexusSec (es. nxs-browser) in apps/<size>, in PNG.
# nuoveXT2 (lxde, PNG multi-size) ha la PRIORITA' sulle icone colorate: sono
# sempre renderizzabili, mentre certe icone Adwaita sono solo SVG (es.
# mimetypes text-x-generic) e su questo stack non si caricano. Le icone
# *-symbolic (pannello/menu) non esistono in lxde e vengono prese da Adwaita.

[apps/16]
Size=16
Context=Applications
Type=Fixed

[apps/22]
Size=22
Context=Applications
Type=Fixed

[apps/24]
Size=24
Context=Applications
Type=Fixed

[apps/32]
Size=32
Context=Applications
Type=Fixed

[apps/48]
Size=48
Context=Applications
Type=Fixed

[apps/64]
Size=64
Context=Applications
Type=Fixed

[apps/128]
Size=128
Context=Applications
Type=Fixed

[apps/256]
Size=256
Context=Applications
Type=Fixed
