#!/bin/sh
# NexusSec - autostart Openbox (Alpine).
# Log in /tmp/nxs-autostart.log per la diagnostica (nxs-diag lo legge).
exec >>/tmp/nxs-autostart.log 2>&1
echo "=== autostart $(date) ==="

# 0) MONITOR: normalizza subito gli schermi. Con 2+ monitor connessi applica la
#    policy (default: DUPLICA; si cambia con "nxs-screens set-policy extend" o
#    dal Centro di Controllo), cosi' l'output esterno viene preso in carico da X
#    e la splash di boot NON resta appiccicata li'. Va fatto PRIMA di
#    splash/pcmanfm/pannello.
#    NB: un output "connected" ma senza CRTC non viene MAI disegnato da X.
command -v nxs-screens >/dev/null 2>&1 && nxs-screens autostart

# SEQUENZA splash -> desktop, SENZA "sbirciata" del desktop prima della splash.
# Ordine che risolve entrambe le cose (glimpse + sovrapposizione):
#   1) la SPLASH parte per PRIMA (background) e ha un attimo di vantaggio per
#      MAPPARE e coprire lo schermo su NERO, prima che esista qualunque finestra
#      del desktop -> niente lampo di desktop prima della splash;
#   2) sfondo + pannello si costruiscono DIETRO la splash (che li tiene coperti
#      col re-raise) durante i suoi ~6.5s;
#   3) il selettore profili aspetta la FINE della splash (wait sul suo PID) e
#      compare solo dopo -> non si sovrappone mai.
# Allo sguardo: nero pulito -> splash piena -> sfuma su sfondo+pannello pronti
# -> appare il selettore.

# 1) SPLASH per prima, in background; ne teniamo il PID come "cancello".
SPLASH_PID=""
if command -v nxs-boot-splash >/dev/null 2>&1; then
  nxs-boot-splash &
  SPLASH_PID=$!
  # Vantaggio: lascia mappare e dipingere la splash su schermo nero PRIMA che
  # partano pcmanfm/pannello (che comparirebbero altrimenti per un istante).
  sleep 0.8
fi

# 2) Audio: PipeWire + WirePlumber (session manager) + compat Pulse. Servizi
#    UTENTE (la live non ha logind), indipendenti dalla grafica. Best-effort.
if command -v pipewire >/dev/null 2>&1; then
  pipewire &
  (sleep 1; command -v wireplumber   >/dev/null 2>&1 && exec wireplumber) &
  (sleep 1; command -v pipewire-pulse >/dev/null 2>&1 && exec pipewire-pulse) &
fi

# 2b) Sblocco audio ROBUSTO (ALSA hardware + sink PipeWire, con ritentativi).
#     Su macchina REALE (avvio da chiavetta) la scheda c'e' e il sink "Analog
#     Stereo" esiste, ma parte MUTO (Master/Speaker/Headphone/"Auto-Mute") e a
#     volte l'UCM lo rimette muto poco dopo -> in VM l'audio va, dallo stick no.
#     nxs-audio-unmute agisce su entrambi i livelli e ripete alcune passate per
#     battere l'inizializzazione tardiva del codec. Parte dopo PipeWire.
command -v nxs-audio-unmute >/dev/null 2>&1 && (sleep 2; nxs-audio-unmute) &

# 3) Desktop manager pcmanfm (icone + SFONDO), DIETRO la splash. Lo sfondo del
#    profilo va impostato via "pcmanfm --set-wallpaper", quindi deve gia' esserci.
command -v pcmanfm >/dev/null 2>&1 && pcmanfm --desktop --profile=NexusSec &

# 4+5) Sfondo/accent/tema-icone del profilo, POI il pannello.
#      ORDINE IMPORTANTE: "nxs-tool apply" riscrive gtk-3.0/settings.ini per
#      impostare il tema icone del profilo. Prima il pannello partiva in
#      PARALLELO e poteva leggere quel file proprio mentre veniva riscritto,
#      ritrovandosi senza tema icone: le icone nostre (logo del menu, browser)
#      non comparivano nella barra, quelle di Adwaita si -> "alcune si vedono e
#      altre no", e servivano un cambio profilo per rimetterle a posto.
#      Avviando il pannello DOPO, legge un file gia' stabile. Il ritardo non si
#      nota: siamo comunque dietro la splash, che dura ~6,5 s.
(sleep 1.5; nxs-tool apply; nxs-panel) &

# 6) Integrazione VirtualBox (mouse seamless + auto-resize). Innocuo altrove.
command -v VBoxClient-all >/dev/null 2>&1 && VBoxClient-all 2>/dev/null &

# 5b) WiFi: riaggancia da solo una rete gia' usata. Con la persistenza attiva
#     (NXSDATA) la configurazione conserva TUTTE le reti a cui ti sei collegato,
#     quindi al riavvio non serve reinserire la password. Senza questa riga le
#     reti restavano salvate ma nessuno le agganciava: wpa_supplicant non sta in
#     nessun runlevel e partiva solo aprendo l'applet del WiFi a mano.
command -v nxs-wifi >/dev/null 2>&1 && (sleep 4; nxs-wifi auto) &

# 6a) WATCHER SCHERMI: riallinea la disposizione quando si collega/scollega un
#     monitor o si chiude il coperchio. Senza questo demone nulla reagiva agli
#     eventi: il monitor esterno collegato dopo l'avvio restava spento (con la
#     sola splash del kernel visibile) e chiudendo il coperchio il desktop
#     restava steso sullo schermo spento, mostrando solo una porzione senza
#     barra. Prima l'unico rimedio era passare dal cambio profilo.
command -v nxs-screens-watch >/dev/null 2>&1 && nxs-screens-watch &

# 6b) Salvaschermo automatico: xautolock lancia nxs-screensaver dopo N minuti
#     di inattivita' (config in ~/.config/nxs/screensaver.conf, modificabile dal
#     Centro di Controllo). Best-effort: se disattivato o senza xautolock, esce.
command -v nxs-screensaver-idle >/dev/null 2>&1 && (sleep 3; nxs-screensaver-idle start) &

# 7) CANCELLO: aspetta che la splash abbia finito (animazione + fade), POI il
#    selettore. Cosi' il desktop "operativo" non esce finche' la splash non e'
#    conclusa. Se la splash non c'era, si prosegue subito.
[ -n "$SPLASH_PID" ] && wait "$SPLASH_PID" 2>/dev/null
nxs-profile &
