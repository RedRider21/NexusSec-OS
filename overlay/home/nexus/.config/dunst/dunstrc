# NexusSec - configurazione dunst (demone notifiche desktop).
# Palette coerente col desktop: sfondo pannello, testo chiaro, bordo tenue,
# accent cyan per le notifiche normali, rosa allarme per le critiche.
[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = 14x44
    width = 360
    height = 200
    notification_limit = 4
    progress_bar = true
    padding = 10
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#1a3a52"
    separator_color = frame
    corner_radius = 10
    font = DejaVu Sans 10
    markup = full
    format = "<b>%s</b>\n%b"
    word_wrap = true
    icon_position = left
    show_indicators = false
    mouse_left_click = close_current
    mouse_right_click = close_all
    mouse_middle_click = do_action, open_url

[urgency_low]
    background = "#0a1a26"
    foreground = "#5a8a9a"
    frame_color = "#1a3a52"
    timeout = 5

[urgency_normal]
    background = "#0a1a26"
    foreground = "#c8f5ff"
    frame_color = "#00e5ff"
    timeout = 8

[urgency_critical]
    background = "#12060e"
    foreground = "#ffd6e4"
    frame_color = "#ff5a8a"
    timeout = 0
