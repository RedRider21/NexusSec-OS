# artefatti di build (rigenerabili, pesanti)
out/
*.iso
*.ppm
*.apk
# ECCEZIONE: la splash nativa di boot e' un ASSET sorgente (rigenerata da
# overlay/.../splash/scene.png), la versioniamo -> build self-contained + rollback.
!build-alpine/fbsplash.ppm
# abuild: sorgenti scaricati e pkg intermedi
aports/*/src/
aports/*/pkg/
aports/**/*.tar.*
aports/**/*.tar
# python
__pycache__/
*.pyc
# chiave privata di firma: MAI in git (resta solo locale)
build-alpine/arsenal-keys/*.rsa
