# Maintainer: NexusSec <deplano.d@gmail.com>
pkgname=dirb
pkgver=2.22
pkgrel=1
pkgdesc="Web content scanner (brute-force directory/file con wordlist)"
url="https://dirb.sourceforge.net/"
arch="all"
license="GPL-2.0-or-later"
makedepends="curl-dev"
source="$pkgname-$pkgver.tar.gz::https://downloads.sourceforge.net/project/dirb/dirb/$pkgver/dirb222.tar.gz"
builddir="$srcdir/dirb222"
build() {
	cd "$builddir"
	chmod +x configure
	# -fcommon: i globali sono definiti negli header senza extern (multiple
	# definition con gcc >=10). configure sostituisce CFLAGS nel Makefile.
	CFLAGS="$CFLAGS -fcommon -D_GNU_SOURCE" ./configure --prefix=/usr
	make
}
package() {
	cd "$builddir"
	install -Dm755 dirb "$pkgdir"/usr/bin/dirb
	mkdir -p "$pkgdir"/usr/share/dirb
	cp -r wordlists "$pkgdir"/usr/share/dirb/ 2>/dev/null || true
	# Licenza dell'autore DENTRO il pacchetto (obbligo per GPL, MIT, BSD: chi
	# riceve il binario deve ricevere avviso di copyright e testo della licenza).
	# Si copiano i file di licenza originali, se ci sono, e si scrive SEMPRE un
	# NOTICE con licenza e sorgente originale (il sorgente completo e' pubblicato
	# anche accanto al repository NexusSec, vedi THIRD-PARTY.md).
	for _l in COPYING COPYING.txt COPYING.md LICENSE LICENSE.txt LICENSE.md \
	          LICENCE COPYRIGHT README.license; do
		if [ -f "$builddir/$_l" ]; then
			install -Dm644 "$builddir/$_l" "$pkgdir/usr/share/licenses/$pkgname/$_l"
		fi
	done
	mkdir -p "$pkgdir/usr/share/licenses/$pkgname"
	printf '%s %s\nLicenza/License: %s\nAutori/Upstream: %s\nSorgente/Source: %s\nPacchetto per NexusSec OS (RedRider21/NexusSec-OS, aports/%s)\n' \
		"$pkgname" "$pkgver" "$license" "$url" "$source" "$pkgname" \
		> "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
sha512sums="
57305160b11be9d48b44ece5848a102ab7a493a7ac30a44c31339fd7ca659866521ba621dc0639dc28bf21c3b5315390b934441590dac7d5b463e68df4b80b81  dirb-2.22.tar.gz
"
